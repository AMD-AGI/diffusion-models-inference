    "${A}/core-hip_dbg_generic.tar.xz" \
    "${A}/core-hip_dev_generic.tar.xz" \
    "${A}/core-ocl_dev_generic.tar.xz" \
    "${A}/core-ocl_lib_generic.tar.xz" \
    "${A}/core-ocl_run_generic.tar.xz" \
    "${A}/core-runtime_dbg_generic.tar.xz" \
    "${A}/core-runtime_dev_generic.tar.xz" \
    "${A}/fft_dbg_${T}.tar.xz" \
    "${A}/fft_dev_${T}.tar.xz" \
    "${A}/fftw3_dbg_generic.tar.xz" \
    "${A}/fftw3_dev_generic.tar.xz" \
    "${A}/hipblasltprovider_dbg_generic.tar.xz" \
    "${A}/hipdnn_dbg_generic.tar.xz" \
    "${A}/hipdnn_dev_generic.tar.xz" \
    "${A}/hipify_dbg_generic.tar.xz" \
    "${A}/hipify_run_generic.tar.xz" \
    "${A}/host-blas_dbg_generic.tar.xz" \
    "${A}/host-blas_dev_generic.tar.xz" \
    "${A}/host-suite-sparse_dbg_generic.tar.xz" \
    "${A}/host-suite-sparse_dev_generic.tar.xz" \
    "${A}/libhipcxx_dbg_${T}.tar.xz" \
    "${A}/libhipcxx_dev_${T}.tar.xz" \
    "${A}/miopen_dbg_${T}.tar.xz" \
    "${A}/miopen_dev_${T}.tar.xz" \
    "${A}/miopenprovider_dbg_generic.tar.xz" \
