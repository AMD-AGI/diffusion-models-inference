# Build example image with
#
# docker build -f docker/Dockerfile.ci \
#              -t amdsiloai/pytorch-xdit:latest .
#
# when running from repository root.
#

# core image arguments
ARG BASE_IMAGE="ubuntu:24.04"
ARG PYTHON_VERSION="default"
ARG THEROCK_COMMIT="9b611c60e4e4125d86e381b20ee332afb10452bd"
# Set ROCM_LIBRARIES_COMMIT_OVERRIDE to force to use a specific commit of rocm-libraries monorepo instead of the one pinned in TheRock.
# This is useful for example for testing a feature not yet in the main branch of rocm-libraries or a commit not available via TheRock.
ARG ROCM_LIBRARIES_COMMIT_OVERRIDE=""
# Set ROCM_SYSTEMS_COMMIT_OVERRIDE to force to use a specific commit of rocm-systems monorepo instead of the one pinned in TheRock.
ARG ROCM_SYSTEMS_COMMIT_OVERRIDE=""
ARG TRITON_COMMIT="a272dfa85e20c6c167a1ec0fab48f7f9f4fd47c4"
ARG PYTORCH_COMMIT="ff65f5bc672795c5e5033900ea0a0c4f8566c8cf"
ARG PYTORCH_VISION_COMMIT="b919bd0c56abbb3c5ca056a3a458af9fd1cabf52"
ARG PYTORCH_AUDIO_COMMIT="e3c6ee2b6588b7cd27a84182de74bf12fe043831"
ARG PYTORCH_CODEC_COMMIT="6df7fc8e81c9509e86833ca48695609c583e2953"
# deps image arguments
ARG AITER_COMMIT="a169e14"
ARG LONGCONTEXTATTENTION_COMMIT="631bdfd"
ARG DIFFUSERS_COMMIT="a80b19218b4bd4faf2d6d8c428dcf1ae6f11e43d"
ARG ACCELERATE_COMMIT="46ba4818cca2103195d7b953779c63ee4027ce61"
ARG DISTVAE_COMMIT="bf7531e"
ARG XDIT_COMMIT="5db664d"
ARG AO_COMMIT="8b72284"
ARG ARBITER_COMMIT="252b0301d072f9d6ea895e32f6898fed951cf295"

FROM ${BASE_IMAGE} AS build_python
ARG PYTHON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
RUN if [ "${PYTHON_VERSION}" = "default" ]; then \
        mkdir -p /opt/python/usr; \
    else \
        # install python3 (optional) dependencies on Ubuntu 24.04
        echo "deb-src http://archive.ubuntu.com/ubuntu noble main universe" \
          >> /etc/apt/sources.list; \
        apt-get update -qq && apt-get build-dep python3 -y && apt-get install --no-install-recommends -y \
            build-essential \
            ca-certificates \
            gdb \
            lcov \
            pkg-config \
            libbz2-dev \
            # unclear if needed
            libexpat1-dev \
            libffi-dev \
            libgdbm-dev \
            libgdbm-compat-dev \
            liblzma-dev \
            libncurses5-dev \
            libreadline6-dev \
            libsqlite3-dev \
            libssl-dev \
            lzma \
            lzma-dev \
            tk-dev \
            uuid-dev \
            zlib1g-dev \
            # do not install on Ubuntu 24.04
#            libmpdec-dev \
            libzstd-dev \
            inetutils-inetd \
            # unclear if needed
            systemtap-sdt-dev \
            wget && \
            update-ca-certificates && \
            rm -rf /var/lib/apt/lists/*; \
        # build prespecified Python version
        wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz; \
        tar -xf Python-${PYTHON_VERSION}.tgz; \
        cd Python-${PYTHON_VERSION}; \
        ./configure \
            --prefix=/usr \
            --enable-shared \
            --enable-optimizations \
            --enable-ipv6 \
            --with-system-ffi \
            # unclear if needed
            --with-system-expat \
            --with-dbmliborder=bdb:gdbm \
            --enable-loadable-sqlite-extensions \
            --with-dtrace; \
        make -j$(nproc); \
        make install DESTDIR=/opt/python; \
    fi

FROM ${BASE_IMAGE} AS base
ARG PYTHON_VERSION
ARG DEBIAN_FRONTEND=noninteractive

# install depedencies
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    automake \
    bison \
    build-essential \
    ca-certificates \
    cmake \
    flex \
    freeglut3-dev \
    gfortran \
    git \
    libgfortran5 \
    libgl1 \
    libgl1-mesa-dev \
    libglib2.0-dev \
    libglu1-mesa-dev \
    libopenblas-dev \
    libtool \
    ninja-build \
    patchelf \
    texinfo \
    wget \
    xxd && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# install python3
COPY --from=build_python /opt/python/usr /usr
RUN if [ "${PYTHON_VERSION}" = "default" ]; then \
        # install system Python
        apt-get update -qq && apt-get install --no-install-recommends -y \
            python3 \
            python3-dev \
            python3-packaging \
            python3-pip \
            python3-venv && \
            rm -rf /var/lib/apt/lists/*; \
    else \
        # install Python optional runtime dependencies
        apt-get update -qq && apt-get install -y --no-install-recommends \
            ca-certificates \
            # from libbz2-dev
            libbz2-1.0 \
            # from libc6-dev
            libc6 \
            # from libffi-dev
            libffi8 \
            # from libgdbm-dev
            libgdbm6t64 \
            # from libgdbm-dev
            libgdbm-compat4t64 \
            # from liblzma-dev
            liblzma5 \
            # from libreadline6-dev
            libreadline8 \
            # from libsqlite3-dev
            libsqlite3-0 \
            # from libssl-dev
            libssl3t64 \
            # from tk-dev
            tk \
            # from uuid-dev
            libuuid1 \
            # from zlib1g-dev
            zlib1g \
            # from libzstd-dev
            libzstd1 \
            # rest are more unclear dependencies
            libdb5.3 \
            libexpat1 \
            libgdbm6 \
            libncurses6 \
            libtirpc3 \
            uuid-runtime && \
            rm -rf /var/lib/apt/lists/*; \
        # setup prespecified Python version
        PYTHON_MINOR="$(echo "$PYTHON_VERSION" | awk -F. '{print $1"."$2}')"; \
        ln -sf /usr/bin/python${PYTHON_MINOR} /usr/bin/python3; \
        ln -sf /usr/bin/pip${PYTHON_MINOR} /usr/bin/pip3; \
        python3 -m ensurepip --upgrade; \
    fi

# setup environment
RUN python3 -m venv venv
ENV PATH="/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip packaging setuptools wheel

FROM base AS setup_therock
ARG THEROCK_COMMIT
ARG ROCM_LIBRARIES_COMMIT_OVERRIDE
ARG ROCM_SYSTEMS_COMMIT_OVERRIDE

WORKDIR /app
RUN git clone https://github.com/ROCm/TheRock.git && \
    cd TheRock && \
    git reset --hard ${THEROCK_COMMIT} && \
    if [ -n "$ROCM_LIBRARIES_COMMIT_OVERRIDE" ]; then \
        echo "Force updating rocm-libraries commit to ${ROCM_LIBRARIES_COMMIT_OVERRIDE}" && \
        git update-index --cacheinfo 160000,${ROCM_LIBRARIES_COMMIT_OVERRIDE},rocm-libraries ; \
    fi && \
    if [ -n "$ROCM_SYSTEMS_COMMIT_OVERRIDE" ]; then \
        echo "Force updating rocm-systems commit to ${ROCM_SYSTEMS_COMMIT_OVERRIDE}" && \
        git update-index --cacheinfo 160000,${ROCM_SYSTEMS_COMMIT_OVERRIDE},rocm-systems ; \
    fi

FROM base AS build_rocm
COPY --from=setup_therock /app/TheRock /app/TheRock
WORKDIR /app/TheRock
# if dvc is available, fetch_source.py uses it to fetch large files - install it along with other requirements.
RUN pip install -r requirements.txt && \
    pip freeze | grep -E 'botocore' > constraints.txt && \
    pip install --no-cache-dir -c constraints.txt "pathspec<0.13.0" "dvc[s3]==3.62.0" && \
    python build_tools/fetch_sources.py --jobs 8 --depth 1
RUN cmake -S /app/TheRock -B /app/TheRock/build -GNinja . \
    -DTHEROCK_AMDGPU_FAMILIES="gfx94X-dcgpu;gfx950-dcgpu" \
    -DTHEROCK_TEST_AMDGPU_FAMILIES="gfx94X-dcgpu;gfx950-dcgpu" \
    -DTHEROCK_BUNDLE_SYSDEPS=ON -DTHEROCK_AMDGPU_DIST_BUNDLE_NAME="gfx94X_gfx950_bundle" \
    -DTHEROCK_ENABLE_ALL=OFF \
    -DTHEROCK_ENABLE_CORE=ON \
    -DTHEROCK_ENABLE_COMM_LIBS=ON \
    -DTHEROCK_ENABLE_DEBUG_TOOLS=ON \
    -DTHEROCK_ENABLE_MATH_LIBS=ON \
    -DTHEROCK_ENABLE_ML_LIBS=ON \
    -DTHEROCK_ENABLE_PROFILER=ON \
    -DTHEROCK_ENABLE_DC_TOOLS=ON \
    -DTHEROCK_ENABLE_MEDIA_LIBS=ON && \
    cmake --build /app/TheRock/build --target therock-archives

FROM base AS rocm_runtime
RUN --mount=type=bind,from=build_rocm,source=/app/TheRock,target=/app/TheRock/ \
    set -eu; \
    A="/app/TheRock/build/artifacts"; T="gfx94X_gfx950_bundle"; O="/opt/rocm"; \
    python3 app/TheRock/build_tools/fileset_tool.py artifact-flatten \
    "${A}/amd-llvm_lib_generic.tar.xz" \
    "${A}/amd-llvm_run_generic.tar.xz" \
    "${A}/base_lib_generic.tar.xz" \
    "${A}/base_run_generic.tar.xz" \
    "${A}/blas_lib_${T}.tar.xz" \
    "${A}/blas_run_${T}.tar.xz" \
    "${A}/composable-kernel_lib_${T}.tar.xz" \
    "${A}/core-amdsmi_lib_generic.tar.xz" \
    "${A}/core-amdsmi_run_generic.tar.xz" \
    "${A}/core-hip_lib_generic.tar.xz" \
    "${A}/core-hip_run_generic.tar.xz" \
    "${A}/core-runtime_lib_generic.tar.xz" \
    "${A}/core-runtime_run_generic.tar.xz" \
    "${A}/fft_lib_${T}.tar.xz" \
    "${A}/fft_run_${T}.tar.xz" \
    "${A}/fftw3_lib_generic.tar.xz" \
    "${A}/fftw3_run_generic.tar.xz" \
    "${A}/hipblasltprovider_lib_generic.tar.xz" \
    "${A}/hipdnn_lib_generic.tar.xz" \
    "${A}/hipdnn_run_generic.tar.xz" \
    "${A}/host-blas_lib_generic.tar.xz" \
    "${A}/host-blas_run_generic.tar.xz" \
    "${A}/host-suite-sparse_lib_generic.tar.xz" \
    "${A}/host-suite-sparse_run_generic.tar.xz" \
    "${A}/libhipcxx_lib_${T}.tar.xz" \
    "${A}/miopen_lib_${T}.tar.xz" \
    "${A}/miopen_run_${T}.tar.xz" \
    "${A}/miopenprovider_lib_generic.tar.xz" \
    "${A}/rand_lib_${T}.tar.xz" \
    "${A}/rand_run_${T}.tar.xz" \
    "${A}/rccl_lib_${T}.tar.xz" \
    "${A}/rccl_run_${T}.tar.xz" \
    # rocprofiler-sdk is needed at runtime: PyTorch Kineto (USE_KINETO=ON) depends
    # on libroctracer64.so which in turn requires librocprofiler-sdk.so
    "${A}/rocprofiler-sdk_lib_generic.tar.xz" \
    "${A}/rocprofiler-sdk_run_generic.tar.xz" \
    "${A}/rocwmma_lib_${T}.tar.xz" \
    "${A}/sysdeps_lib_generic.tar.xz" \
    "${A}/sysdeps_run_generic.tar.xz" \
    "${A}/sysdeps-expat_lib_generic.tar.xz" \
    "${A}/sysdeps-gmp_lib_generic.tar.xz" \
    "${A}/sysdeps-hwloc_lib_generic.tar.xz" \
    "${A}/sysdeps-libpciaccess_lib_generic.tar.xz" \
    "${A}/sysdeps-mpfr_lib_generic.tar.xz" \
    "${A}/sysdeps-ncurses_lib_generic.tar.xz" \
    -o "${O}"
# Install amdsmi Python module
RUN cd /opt/rocm/share/amd_smi && \
    pip install --no-cache-dir .
RUN echo "/opt/rocm/lib" > /etc/ld.so.conf.d/rocm.conf && \
    echo "/opt/rocm/lib/rocm_sysdeps/lib/" > /etc/ld.so.conf.d/rocm_sysdeps.conf && \
    ldconfig
ENV PATH="/opt/rocm/bin:$PATH" \
    ROCM_HOME=/opt/rocm \
    ROCM_PATH=/opt/rocm \
    HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode

FROM rocm_runtime AS rocm_devel
RUN --mount=type=bind,from=build_rocm,source=/app/TheRock,target=/app/TheRock/ \
    set -eu; \
    A="/app/TheRock/build/artifacts"; T="gfx94X_gfx950_bundle"; O="/opt/rocm"; \
    python3 app/TheRock/build_tools/fileset_tool.py artifact-flatten \
    "${A}/amd-dbgapi_dbg_generic.tar.xz" \
    "${A}/amd-dbgapi_dev_generic.tar.xz" \
