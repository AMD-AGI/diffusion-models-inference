# Copyright Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Build example image with
#
# docker build -f docker/Dockerfile.ci \
#              -t amdsiloai/pytorch-xdit:latest .
#
# when running from repository root.
#

# core image arguments
ARG BASE_IMAGE="ubuntu:24.04"
# ROCm, PyTorch, torchvision, torchaudio, and Triton are TheRock wheels from
# one index. ROCM_WHEEL_VERSION selects one TheRock build; torch pins rocm and
# triton to that exact version.
ARG ROCM_WHEEL_INDEX="https://nightly.repo.amd.com/rocm/whl-next"
ARG ROCM_WHEEL_VERSION="10.3.0a20261108"
# ROCM_GFX_TARGETS selects the architecture-specific device wheels and the
# MORI GPU targets.
# Values are ";" separated; supported LLVM targets are documented at
# https://rocm.docs.amd.com/projects/install-on-linux/en/latest/reference/system-requirements.html#supported-gpus
ARG ROCM_GFX_TARGETS="gfx942;gfx950"
# The local version suffix "+rocm${ROCM_WHEEL_VERSION}" is added in the
# install script. Triton comes as the exact pin of torch.
ARG TORCH_VERSION="2.14.0"
ARG TORCHVISION_VERSION="0.29.0"
ARG TORCHAUDIO_VERSION="2.11.0.3"
ARG MORI_COMMIT="01de777c122923bacc6f0f50dedfe94a240435b0"
# final image arguments
ARG AITER_COMMIT="04913fc854631d74147a926ad8be005c8a0bb133"
ARG LONGCONTEXTATTENTION_COMMIT="631bdfd"
ARG DIFFUSERS_COMMIT="51349f7ac2da4853852efdc1befc92669946e68a"
ARG DISTVAE_COMMIT="dce484185dc11d7406076117771e36acd796aa6a"
ARG XDIT_COMMIT="8d7467a5b53849b7b6e0fa7366b65d7b445a28ac"
# PyAV is built from source against our LGPL-only FFmpeg (stage build_pyav).
# PyAV 17 and later need FFmpeg 8, so keep 16.1.0 while FFmpeg is 7.1.
ARG PYAV_VERSION="16.1.0"

FROM ${BASE_IMAGE} AS base
ARG DEBIAN_FRONTEND=noninteractive

# Shared fetch/compiler tools. Native extensions in core (AITER)
# and the MORI/ffmpeg builders still need a host toolchain.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    ninja-build \
    python3 \
    python3-dev \
    python3-packaging \
    python3-pip \
    python3-venv \
    wget && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# setup environment
RUN python3 -m venv venv
ENV PATH="/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip packaging setuptools wheel

# ROCm SDK and the PyTorch stack, all from TheRock wheels. /opt/rocm is a link
# to the initialized rocm-sdk-devel tree in the venv.
FROM base AS rocm_sdk
ARG ROCM_WHEEL_INDEX
ARG ROCM_WHEEL_VERSION
ARG ROCM_GFX_TARGETS
ARG TORCH_VERSION
ARG TORCHVISION_VERSION
ARG TORCHAUDIO_VERSION
ENV ROCM_WHEEL_CONSTRAINTS=/opt/rocm-wheel-constraints.txt
COPY docker/install_rocm_wheels.sh /usr/local/bin/install_rocm_wheels
COPY docker/setup_amdsmi.sh /usr/local/bin/setup_amdsmi
RUN chmod +x /usr/local/bin/install_rocm_wheels \
        /usr/local/bin/setup_amdsmi \
    && install_rocm_wheels
# Keep the ROCm wheels pinned in every later pip run.
ENV PIP_CONSTRAINT="${ROCM_WHEEL_CONSTRAINTS}"
# The SDK wheels ship the amd-smi Python bindings somewhere pip cannot reach;
# link them into site-packages. Prints a RETIRE banner and does nothing once a
# release makes `import amdsmi` work on its own.
RUN setup_amdsmi
# rocm-profiler puts rocprof-compute and the other profiler tools in
# /venv/bin, which is already on PATH.
ENV PATH="/opt/rocm/lib/llvm/bin:/opt/rocm/bin:$PATH" \
    ROCM_HOME=/opt/rocm \
    ROCM_PATH=/opt/rocm \
    HIP_CLANG_PATH=/opt/rocm/lib/llvm/bin \
    HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode \
    TRITON_HIP_LLD_PATH=/opt/rocm/lib/llvm/bin/ld.lld

FROM base AS ffmpeg_builder
# Reference: https://trac.ffmpeg.org/wiki/CompilationGuide/Ubuntu
# Install build depedencies, server use only
RUN apt-get update -qq && apt-get -y install --no-install-recommends \
    autoconf \
    automake \
    build-essential \
    ca-certificates \
    cmake \
    git-core \
    libaom-dev \
    libass-dev \
    libdav1d-dev \
    libfreetype6-dev \
    libgnutls28-dev \
    libmp3lame-dev \
    libopenh264-dev \
    libtool \
    libunistring-dev \
    libvorbis-dev \
    meson \
    ninja-build \
    pkg-config \
    texinfo \
    wget \
    yasm \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# See https://ffmpeg.org/releases/ for valid choices of FFMPEG_VERSION
ARG FFMPEG_VERSION="7.1.4"
ENV FFMPEG_BUILD_DIR=/ffmpeg/build
ENV FFMPEG_SRC_DIR=/ffmpeg/src
ENV FFMPEG_BIN_DIR=/ffmpeg/bin
RUN mkdir -p ${FFMPEG_BUILD_DIR} ${FFMPEG_SRC_DIR}
WORKDIR ${FFMPEG_SRC_DIR}
# Never set --enable-gpl or --enable-nonfree to maintain non-GPL license compliance!
RUN wget -O ffmpeg-${FFMPEG_VERSION}.tar.bz2 https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.bz2 && \
    tar xjvf ffmpeg-${FFMPEG_VERSION}.tar.bz2 && \
    cd ffmpeg-${FFMPEG_VERSION} && \
    PATH="$FFMPEG_BIN_DIR:$PATH" PKG_CONFIG_PATH="$FFMPEG_BUILD_DIR/lib/pkgconfig" ./configure \
    --prefix="$FFMPEG_BUILD_DIR" \
    --pkg-config-flags="--static" \
    --extra-cflags="-I$FFMPEG_BUILD_DIR/include" \
    --extra-ldflags="-L$FFMPEG_BUILD_DIR/lib" \
    --extra-libs="-lpthread -lm" \
    --ld="g++" \
    --bindir="$FFMPEG_BIN_DIR" \
    --enable-gnutls \
    --enable-libaom \
    --enable-libass \
    --enable-libdav1d \
    --enable-libfreetype \
    --enable-libmp3lame \
    --enable-libopenh264 \
    --enable-libvorbis \
    --enable-shared \
    --disable-static \
    --disable-doc && \
    PATH="$FFMPEG_BIN_DIR:$PATH" make -j$(($(nproc)-1)) && \
    make install && \
    hash -r
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /ffmpeg/license-evidence \
    --scan-root ffmpeg=${FFMPEG_SRC_DIR}

# The PyAV wheels on PyPI bundle their own FFmpeg with GPL x264 and x265.
# Build PyAV from source against our LGPL-only FFmpeg instead. The wheel links
# libav*.so by soname, and core supplies these libraries in /usr/local/lib.
FROM ffmpeg_builder AS build_pyav
ARG PYAV_VERSION
RUN mkdir -p /wheel && \
    PKG_CONFIG_PATH="${FFMPEG_BUILD_DIR}/lib/pkgconfig" \
    pip wheel --no-cache-dir --no-deps --no-binary av "av==${PYAV_VERSION}" --wheel-dir /wheel

# MORI provides the symmetric memory behind AITER's intranode attention A2A.
# UMBP stays off: its control plane needs gRPC and protobuf. Without UMBP only
# the msgpack-c and spdlog submodules are built.
FROM rocm_sdk AS build_mori
ARG MORI_COMMIT
ARG ROCM_GFX_TARGETS
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libibverbs-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
# A full clone, so setuptools-scm can derive the release version.
RUN git clone https://github.com/ROCm/mori.git && \
    cd mori && \
    git checkout --detach ${MORI_COMMIT} && \
    git submodule update --init 3rdparty/msgpack-c 3rdparty/spdlog
# MORI_GPU_ARCHS, because MORI prefers a detected local GPU over the targets.
# CMake and the linker use ROCm's bundled NUMA and DRM sysdeps. MORI puts
# ${ROCM_PATH}/lib (/opt/rocm/lib) in its RPATH; the /opt/rocm link resolves
# it in every later stage.
RUN mkdir -p /wheel && \
    cd mori && \
    BUILD_UMBP=OFF \
    BUILD_TORCH_SYMM=OFF \
    CMAKE_PREFIX_PATH="${ROCM_HOME}/lib/rocm_sysdeps" \
    LDFLAGS="-L${ROCM_HOME}/lib/rocm_sysdeps/lib" \
    MORI_GPU_ARCHS="${ROCM_GFX_TARGETS}" \
    pip wheel . --no-deps --wheel-dir /wheel && \
    rm -rf build

FROM build_mori AS evidence_mori
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /evidence/mori \
    --scan-root mori=/app/mori \
    --git-root /app/mori \
    --fail-on-missing-git-license \
    --required-git-depth 0

FROM rocm_sdk AS core
ARG AITER_COMMIT
# Runtime libs for FFmpeg.
RUN apt-get update -qq && apt-get -y install --no-install-recommends \
  libaom3 \
  libass9 \
  libdav1d7 \
  libfreetype6 \
  libglib2.0-0t64 \
  libgnutls30 \
  libmp3lame0 \
  libopenh264-7 \
  libvorbis0a \
  libvorbisenc2 \
  && rm -rf /var/lib/apt/lists/*
# Copy built FFmpeg artifacts from the builder stage
COPY --from=ffmpeg_builder /ffmpeg/bin /usr/local/bin
COPY --from=ffmpeg_builder /ffmpeg/build/lib /usr/local/lib
COPY --from=ffmpeg_builder /ffmpeg/build/include /usr/local/include
COPY --from=ffmpeg_builder /ffmpeg/build/share /usr/local/share
# Update library cache
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig
COPY docker/libkineto.conf /config/libkineto.conf
ENV KINETO_CONFIG="/config/libkineto.conf"
# Keep Inductor compile workers alive. Python 3.12.3 can deadlock a worker
# when the pool forks again after quiesce (pytorch/pytorch#200848).
# Remove when the image uses Python >= 3.12.8 or PyTorch has the fix.
ENV TORCHINDUCTOR_QUIESCE_ASYNC_COMPILE_POOL=0
# install aiter
WORKDIR /app/external
# Keep the Triton wheel that torch pins; otherwise AITER's setup.py would
# uninstall it and pull a wheel from pypi.amd.com (see
# https://github.com/ROCm/aiter/pull/3161). No-op on AITER_COMMIT pins predating
# that PR, but safe and forward-compatible.
ENV AITER_USE_SYSTEM_TRITON=1
# PIP_NO_CACHE_DIR, because --no-cache-dir does not reach the pip subprocess
# that installs AITER's build-system requirements into the isolated build env.
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/ROCm/aiter.git && \
    cd aiter && \
    git reset --hard ${AITER_COMMIT} && \
    git apply /patches/aiter_mha_functional_varlen.patch && \
    git submodule update --init --recursive && \
    pip install --no-cache-dir -r requirements.txt && \
    PIP_NO_CACHE_DIR=1 pip install -e .
RUN --mount=type=bind,from=build_mori,source=/wheel,target=/mori-wheel \
    pip install --no-cache-dir /mori-wheel/*.whl
# Held in core rather than final so that no stage downstream of core has an edge
# back into a builder stage.
COPY --from=ffmpeg_builder /ffmpeg/license-evidence /opt/license-evidence/ffmpeg-build-sources
COPY --from=evidence_mori /evidence/mori /opt/license-evidence/mori-build-sources

FROM core AS final
ARG LONGCONTEXTATTENTION_COMMIT
ARG DIFFUSERS_COMMIT
ARG DISTVAE_COMMIT
ARG XDIT_COMMIT
ARG PYAV_VERSION
# Keep the pip cache out of the image layers. The environment variable also
# reaches the pip subprocesses of editable installs, which --no-cache-dir does
# not. An ARG is not kept in the image, so users get the default pip cache.
ARG PIP_NO_CACHE_DIR=1

# setup
WORKDIR /app/external
# install yunchang
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/feifeibear/long-context-attention.git && \
    cd long-context-attention && \
    git reset --hard ${LONGCONTEXTATTENTION_COMMIT} && \
    git apply /patches/yunchang_aiter_round_mode.patch && \
    pip install -e .
# install transformers with [sentencepiece] extras that brings in protobuf, required for T5 tokenizers
RUN pip install --no-cache-dir "transformers[sentencepiece]==5.16.1"
# install diffusers
# ftfy is an optional dependency, we install it as needed for StableDiffusion 3.5 (CLIP-based encoder pipelines)
# final rm step is needed presently to pass a release process image scan
RUN git clone https://github.com/huggingface/diffusers.git && \
    cd diffusers && \
    git reset --hard ${DIFFUSERS_COMMIT} && \
    pip install -e ".[torch]" && \
    rm scripts/convert_vq_diffusion_to_diffusers.py && \
    pip install --no-cache-dir "ftfy"
# install torchao
RUN pip install --no-cache-dir "torchao==0.18.0"
# install distvae
RUN git clone https://github.com/xdit-project/DistVAE.git && \
    cd DistVAE && \
    git reset --hard ${DISTVAE_COMMIT} && \
    pip install -e .
# install PyAV built against our LGPL-only FFmpeg, before xfuser pulls in the PyPI wheel
RUN --mount=type=bind,from=build_pyav,source=/wheel,target=/pyav-wheel \
    pip install --no-cache-dir /pyav-wheel/av-*.whl && \
    python -c "import av; assert 'libx264' not in av.codecs_available and 'libopenh264' in av.codecs_available, av.codecs_available"
# install xfuser
WORKDIR /app
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/xdit-project/xDiT.git && \
    cd xDiT && \
    git reset --hard ${XDIT_COMMIT} && \
    git apply /patches/xfuser_ltx25_disable_gc_during_inference.patch && \
    git apply /patches/xfuser_video_codec_fallback.patch && \
    { pip freeze | grep numpy; echo "av==${PYAV_VERSION}"; } > constraints.txt && \
    pip install -c constraints.txt -e .
# rocprofiler-compute ships in the rocm-profiler wheel.
# Due to https://github.com/ROCm/rocm-systems/pull/2821 drop numpy to avoid installing numpy<2
# Filter a copy, so that the ROCm tree in the image stays unchanged.
RUN rocprof_compute_requirements="$(python3 -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/_rocm_profiler/libexec/rocprofiler-compute/requirements.txt" && \
    sed '/numpy/d' "${rocprof_compute_requirements}" > /tmp/rocprof-compute-requirements.txt && \
    pip install --no-cache-dir -r /tmp/rocprof-compute-requirements.txt && \
    rm /tmp/rocprof-compute-requirements.txt
# imageio + imageio-ffmpeg for diffusers export_to_video H.264 encoding
# --no-binary avoids shipping imageio-ffmpeg's bundled GPL ffmpeg binary
RUN pip install --no-cache-dir --no-binary :all: imageio-ffmpeg
RUN pip install --no-cache-dir imageio
COPY LICENSE /tmp/project-license/LICENSE

# install basic terminal utilities
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    less \
    nano \
    vim \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# copy assets
COPY assets/data /app/data
# copy instructions and CI prerequisites
COPY assets/docs/README.md /app/README.md
COPY .ci/run.py /app/.ci/run.py
COPY .ci/memory_sampler.py /app/.ci/memory_sampler.py
COPY .ci/miopen_driver_commands.py /app/.ci/miopen_driver_commands.py
COPY .ci/determinism_report.py /app/.ci/determinism_report.py
COPY benchmark_configs/xdit/ /app/.ci/benchmark_configs/
RUN if [ -d /app/xDiT/.ci/configs ]; then \
      cp -a /app/xDiT/.ci/configs /app/.ci/benchmark_configs_xdit; \
    fi
COPY src/sweep_tooling/generate_sweep_configs.py /app/.ci/tools/generate_sweep_configs.py
# use shared MIOpen databases
COPY ./data/miopen/userdb /miopen_userdb
ENV MIOPEN_USER_DB_PATH="/miopen_userdb"

# Generate third-party license evidence from the final filesystem instead of
# maintaining a dependency list separately from the image build.
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /usr/share/licenses/diffusion-models-inference \
    --scan-root app=/app \
    --scan-root project=/tmp/project-license \
    --scan-root python=/venv \
    --scan-root rocm=/opt/rocm \
    --scan-root local=/usr/local \
    --evidence-root ffmpeg-build-sources=/opt/license-evidence/ffmpeg-build-sources \
    --evidence-root mori-build-sources=/opt/license-evidence/mori-build-sources \
    --git-root /app \
    --python-root /venv \
    --debian \
    --fail-on-missing-git-license \
    --required-git-depth 2 && \
    rm -rf /tmp/project-license \
        /usr/local/libexec/collect_image_licenses.py
