# Copyright Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Build example image with
#
# docker build -f docker/Dockerfile.ci \
#              -t amdsiloai/pytorch-xdit:latest .
#
# when running from repository root.
#

# core image arguments
ARG BASE_IMAGE="ubuntu:24.04"
# TheRock multi-arch wheel stack. Keep these versions on one ROCm build date.
ARG THEROCK_WHEEL_INDEX="https://nightly.repo.amd.com/rocm/whl-next/"
ARG ROCM_WHEEL_VERSION="10.3.0a20261104"
ARG PYTORCH_WHEEL_VERSION="2.16.0a0+rocm10.3.0a20261104"
ARG PYTORCH_VISION_WHEEL_VERSION="0.30.0a0+rocm10.3.0a20261104"
ARG PYTORCH_AUDIO_WHEEL_VERSION="2.11.1+rocm10.3.0a20261104"
# ROCM_GFX_TARGETS selects TheRock device wheel extras and MORI architectures.
ARG ROCM_GFX_TARGETS="gfx942;gfx950"
ARG MORI_COMMIT="01de777c122923bacc6f0f50dedfe94a240435b0"
# deps image arguments
ARG AITER_COMMIT="f705d6b7a0637b411a3c177b2fc523f9ce31d0ca"
ARG LONGCONTEXTATTENTION_COMMIT="631bdfd"
ARG DIFFUSERS_COMMIT="51349f7ac2da4853852efdc1befc92669946e68a"
ARG DISTVAE_COMMIT="dce484185dc11d7406076117771e36acd796aa6a"
ARG XDIT_COMMIT="405a46b3b52c69636067b3b419a3f2d060fa9702"

FROM ${BASE_IMAGE} AS base
ARG DEBIAN_FRONTEND=noninteractive

# Shared fetch/compiler tools. Native extensions in core (AITER)
# and the MORI/FFmpeg builders still need a host toolchain.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    ninja-build \
    python3 \
    python3-dev \
    python3-packaging \
    python3-pip \
    python3-venv \
    wget && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# setup environment
RUN python3 -m venv venv
ENV PATH="/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip packaging setuptools wheel

FROM base AS rocm_devel
ARG THEROCK_WHEEL_INDEX
ARG ROCM_WHEEL_VERSION
ARG PYTORCH_WHEEL_VERSION
ARG PYTORCH_VISION_WHEEL_VERSION
ARG PYTORCH_AUDIO_WHEEL_VERSION
ARG ROCM_GFX_TARGETS

COPY docker/install_therock_wheels.sh /usr/local/bin/install_therock_wheels
COPY docker/setup_amdsmi.sh /usr/local/bin/setup_amdsmi
RUN chmod +x /usr/local/bin/install_therock_wheels \
        /usr/local/bin/setup_amdsmi
RUN THEROCK_WHEEL_INDEX="${THEROCK_WHEEL_INDEX}" \
    ROCM_GFX_TARGETS="${ROCM_GFX_TARGETS}" \
    ROCM_WHEEL_VERSION="${ROCM_WHEEL_VERSION}" \
    PYTORCH_WHEEL_VERSION="${PYTORCH_WHEEL_VERSION}" \
    PYTORCH_VISION_WHEEL_VERSION="${PYTORCH_VISION_WHEEL_VERSION}" \
    PYTORCH_AUDIO_WHEEL_VERSION="${PYTORCH_AUDIO_WHEEL_VERSION}" \
    install_therock_wheels

# Ubuntu 24.04 supplies Python 3.12, and this image fixes the venv at /venv.
# These are the paths exposed by `rocm-sdk path` after `rocm-sdk init`.
ENV ROCM_HOME=/venv/lib/python3.12/site-packages/_rocm_sdk_devel \
    ROCM_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel \
    ROCM_SOURCE_DIR=/venv/lib/python3.12/site-packages/_rocm_sdk_devel \
    HIP_CLANG_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/llvm/bin \
    HIP_DEVICE_LIB_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/llvm/amdgcn/bitcode \
    ROCM_DEVICE_LIB_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/llvm/amdgcn/bitcode \
    TRITON_HIP_LLD_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/llvm/bin/ld.lld \
    CMAKE_PREFIX_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/cmake \
    PKG_CONFIG_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/rocm_sysdeps/lib/pkgconfig \
    LD_LIBRARY_PATH=/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/host-math/lib:/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/rocm_sysdeps/lib \
    PATH="/venv/lib/python3.12/site-packages/_rocm_sdk_devel/bin:/venv/lib/python3.12/site-packages/_rocm_sdk_devel/lib/llvm/bin:$PATH"
RUN test "$(rocm-sdk path --root)" = "${ROCM_HOME}" && \
    test "$(rocm-sdk path --cmake)" = "${CMAKE_PREFIX_PATH}" && \
    setup_amdsmi && \
    ln -s "${ROCM_HOME}" /opt/rocm

FROM base AS ffmpeg_builder
# Reference: https://trac.ffmpeg.org/wiki/CompilationGuide/Ubuntu
# Install build depedencies, server use only
RUN apt-get update -qq && apt-get -y install --no-install-recommends \
    autoconf \
    automake \
    build-essential \
    ca-certificates \
    cmake \
    git-core \
    libaom-dev \
    libass-dev \
    libdav1d-dev \
    libfreetype6-dev \
    libgnutls28-dev \
    libmp3lame-dev \
    libopenh264-dev \
    libtool \
    libunistring-dev \
    libvorbis-dev \
    meson \
    ninja-build \
    pkg-config \
    texinfo \
    wget \
    yasm \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# See https://ffmpeg.org/releases/ for valid choices of FFMPEG_VERSION
ARG FFMPEG_VERSION="7.1.3"
ENV FFMPEG_BUILD_DIR=/ffmpeg/build
ENV FFMPEG_SRC_DIR=/ffmpeg/src
ENV FFMPEG_BIN_DIR=/ffmpeg/bin
RUN mkdir -p ${FFMPEG_BUILD_DIR} ${FFMPEG_SRC_DIR}
WORKDIR ${FFMPEG_SRC_DIR}
# Never set --enable-gpl or --enable-nonfree to maintain non-GPL license compliance!
RUN wget -O ffmpeg-${FFMPEG_VERSION}.tar.bz2 https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.bz2 && \
    tar xjvf ffmpeg-${FFMPEG_VERSION}.tar.bz2 && \
    cd ffmpeg-${FFMPEG_VERSION} && \
    PATH="$FFMPEG_BIN_DIR:$PATH" PKG_CONFIG_PATH="$FFMPEG_BUILD_DIR/lib/pkgconfig" ./configure \
    --prefix="$FFMPEG_BUILD_DIR" \
    --pkg-config-flags="--static" \
    --extra-cflags="-I$FFMPEG_BUILD_DIR/include" \
    --extra-ldflags="-L$FFMPEG_BUILD_DIR/lib" \
    --extra-libs="-lpthread -lm" \
    --ld="g++" \
    --bindir="$FFMPEG_BIN_DIR" \
    --enable-gnutls \
    --enable-libaom \
    --enable-libass \
    --enable-libdav1d \
    --enable-libfreetype \
    --enable-libmp3lame \
    --enable-libopenh264 \
    --enable-libvorbis \
    --enable-shared && \
    PATH="$FFMPEG_BIN_DIR:$PATH" make -j$(($(nproc)-1)) && \
    make install && \
    hash -r
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /ffmpeg/license-evidence \
    --scan-root ffmpeg=${FFMPEG_SRC_DIR}

# MORI provides the symmetric memory behind AITER's intranode attention A2A.
# UMBP stays off: its control plane needs gRPC and protobuf. Without UMBP only
# the msgpack-c and spdlog submodules are built.
FROM rocm_devel AS build_mori
ARG MORI_COMMIT
ARG ROCM_GFX_TARGETS
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libibverbs-dev && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
# A full clone, so setuptools-scm can derive the release version.
RUN git clone https://github.com/ROCm/mori.git && \
    cd mori && \
    git checkout --detach ${MORI_COMMIT} && \
    git submodule update --init 3rdparty/msgpack-c 3rdparty/spdlog
# MORI_GPU_ARCHS, because MORI prefers a detected local GPU over build targets.
# CMake and the linker use ROCm's bundled NUMA and DRM sysdeps.
RUN mkdir -p /wheel && \
    cd mori && \
    BUILD_UMBP=OFF \
    BUILD_TORCH_SYMM=OFF \
    CMAKE_PREFIX_PATH="${CMAKE_PREFIX_PATH}:${ROCM_HOME}/lib/rocm_sysdeps" \
    LDFLAGS="-L${ROCM_HOME}/lib/rocm_sysdeps/lib" \
    MORI_GPU_ARCHS="${ROCM_GFX_TARGETS}" \
    pip wheel . --no-deps --wheel-dir /wheel && \
    rm -rf build

FROM build_mori AS evidence_mori
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /evidence/mori \
    --scan-root mori=/app/mori \
    --git-root /app/mori \
    --fail-on-missing-git-license \
    --required-git-depth 0

FROM rocm_devel AS core
ARG AITER_COMMIT
# Runtime libs for the locally built FFmpeg and OpenCV/GLib. Keep the prior
# OpenBLAS/Fortran runtime contract for downstream native extensions.
RUN apt-get update -qq && apt-get -y install --no-install-recommends \
  libaom3 \
  libass9 \
  libdav1d7 \
  libfreetype6 \
  libgfortran5 \
  libgl1 \
  libglib2.0-0t64 \
  libgnutls30 \
  libmp3lame0 \
  libopenblas0 \
  libopenh264-7 \
  libvorbis0a \
  libvorbisenc2 \
  && rm -rf /var/lib/apt/lists/*
# Copy built FFmpeg artifacts from the builder stage
COPY --from=ffmpeg_builder /ffmpeg/bin /usr/local/bin
COPY --from=ffmpeg_builder /ffmpeg/build/lib /usr/local/lib
COPY --from=ffmpeg_builder /ffmpeg/build/include /usr/local/include
COPY --from=ffmpeg_builder /ffmpeg/build/share /usr/local/share
# Update library cache
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig
COPY docker/libkineto.conf /config/libkineto.conf
ENV KINETO_CONFIG="/config/libkineto.conf"
# install aiter
WORKDIR /app/external
# Keep the Triton wheel selected by TheRock's PyTorch package; otherwise AITER's
# setup.py would uninstall it and pull a wheel from pypi.amd.com (see
# https://github.com/ROCm/aiter/pull/3161). No-op on AITER_COMMIT pins predating
# that PR, but safe and forward-compatible.
ENV AITER_USE_SYSTEM_TRITON=1
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/ROCm/aiter.git && \
    cd aiter && \
    git reset --hard ${AITER_COMMIT} && \
    git apply /patches/aiter_mha_functional_varlen.patch && \
    git apply /patches/aiter_flydsl_attention_disable_compile.patch && \
    git submodule update --init --recursive && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install -e .
RUN --mount=type=bind,from=build_mori,source=/wheel,target=/mori-wheel \
    pip install --no-cache-dir /mori-wheel/*.whl
# Held in core rather than final so that no stage downstream of core has an edge
# back into a builder stage.
COPY --from=ffmpeg_builder /ffmpeg/license-evidence /opt/license-evidence/ffmpeg-build-sources
COPY --from=evidence_mori /evidence/mori /opt/license-evidence/mori-build-sources

FROM core AS deps
ARG LONGCONTEXTATTENTION_COMMIT
ARG DIFFUSERS_COMMIT
ARG DISTVAE_COMMIT
ARG XDIT_COMMIT

# setup
WORKDIR /app/external
# install yunchang
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/feifeibear/long-context-attention.git && \
    cd long-context-attention && \
    git reset --hard ${LONGCONTEXTATTENTION_COMMIT} && \
    git apply /patches/yunchang_aiter_round_mode.patch && \
    pip install -e .
# install transformers with [sentencepiece] extras that brings in protobuf, required for T5 tokenizers
RUN pip install --no-cache-dir "transformers[sentencepiece]==5.16.1"
# install diffusers
# ftfy is an optional dependency, we install it as needed for StableDiffusion 3.5 (CLIP-based encoder pipelines)
# final rm step is needed presently to pass a release process image scan
RUN git clone https://github.com/huggingface/diffusers.git && \
    cd diffusers && \
    git reset --hard ${DIFFUSERS_COMMIT} && \
    pip install -e ".[torch]" && \
    rm scripts/convert_vq_diffusion_to_diffusers.py && \
    pip install --no-cache-dir "ftfy"
# install torchao
RUN pip install --no-cache-dir "torchao==0.18.0"
# install distvae
RUN git clone https://github.com/xdit-project/DistVAE.git && \
    cd DistVAE && \
    git reset --hard ${DISTVAE_COMMIT} && \
    pip install -e .
# install xfuser
WORKDIR /app
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/xdit-project/xDiT.git && \
    cd xDiT && \
    git reset --hard ${XDIT_COMMIT} && \
    git apply /patches/xfuser_ltx25_disable_gc_during_inference.patch && \
    pip freeze | grep numpy > constraints.txt && \
    pip install -c constraints.txt -e .
# rocprofiler-compute ships in the rocm-profiler wheel. Preserve the existing
# NumPy override while locating requirements through wheel metadata instead of
# assuming a native-package path.
RUN requirements="$(python3 -c 'from importlib.metadata import distribution; d=distribution("rocm-profiler"); p=[d.locate_file(f) for f in (d.files or []) if str(f).endswith("libexec/rocprofiler-compute/requirements.txt")]; assert len(p) == 1, p; print(p[0])')" && \
    sed -i '/numpy/d' "${requirements}" && \
    pip install --no-cache-dir -r "${requirements}"
# imageio + imageio-ffmpeg for diffusers export_to_video H.264 encoding
# --no-binary avoids shipping imageio-ffmpeg's bundled GPL ffmpeg binary
RUN pip install --no-cache-dir --no-binary :all: imageio-ffmpeg
RUN pip install --no-cache-dir imageio

FROM core AS final
# by copying from the deps stage we leave behind all cache and temporary files created during installation
COPY --from=deps /venv /venv
COPY --from=deps /app /app
COPY LICENSE /tmp/project-license/LICENSE

# install basic terminal utilities
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    less \
    nano \
    vim \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# copy assets
COPY assets/data /app/data
# copy instructions and CI prerequisites
COPY assets/docs/README.md /app/README.md
COPY .ci/run.py /app/.ci/run.py
COPY .ci/memory_sampler.py /app/.ci/memory_sampler.py
COPY .ci/miopen_driver_commands.py /app/.ci/miopen_driver_commands.py
COPY .ci/determinism_report.py /app/.ci/determinism_report.py
COPY benchmark_configs/xdit/ /app/.ci/benchmark_configs/
RUN if [ -d /app/xDiT/.ci/configs ]; then \
      cp -a /app/xDiT/.ci/configs /app/.ci/benchmark_configs_xdit; \
    fi
COPY src/sweep_tooling/generate_sweep_configs.py /app/.ci/tools/generate_sweep_configs.py
# use shared MIOpen databases
COPY ./data/miopen/userdb /miopen_userdb
ENV MIOPEN_USER_DB_PATH="/miopen_userdb"

# Generate third-party license evidence from the final filesystem instead of
# maintaining a dependency list separately from the image build.
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /usr/share/licenses/diffusion-models-inference \
    --scan-root app=/app \
    --scan-root project=/tmp/project-license \
    --scan-root python=/venv \
    --scan-root local=/usr/local \
    --evidence-root ffmpeg-build-sources=/opt/license-evidence/ffmpeg-build-sources \
    --evidence-root mori-build-sources=/opt/license-evidence/mori-build-sources \
    --git-root /app \
    --python-root /venv \
    --debian \
    --fail-on-missing-git-license \
    --required-git-depth 2 && \
    rm -rf /tmp/project-license \
        /usr/local/libexec/collect_image_licenses.py
