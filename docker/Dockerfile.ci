# Copyright Advanced Micro Devices, Inc.
# SPDX-License-Identifier: MIT

# Build example image with
#
# docker build -f docker/Dockerfile.ci \
#              -t amdsiloai/pytorch-xdit:latest .
#
# when running from repository root.
#

# core image arguments
ARG BASE_IMAGE="ubuntu:24.04"
ARG PYTHON_VERSION="default"
ARG THEROCK_COMMIT="ab56f1f7c5b54746bf9f7948fff3f306b2bef8b2"
ARG ROCM_PACKAGE_REPOSITORY="legacy"
ARG ROCM_RELEASE_ID="20260817-31980779979"
ARG ROCM_DEB_SERIES="10.1"
# ROCM_GFX_TARGETS selects architecture-specific nightly deb package shards.
# PYTORCH_ROCM_ARCH defaults to the package targets but can be overridden.
# Values are ";" separated; supported LLVM targets are documented at
# https://rocm.docs.amd.com/projects/install-on-linux/en/latest/reference/system-requirements.html#supported-gpus
ARG ROCM_GFX_TARGETS="gfx942;gfx950"
# Parent of core, deps, and final. rocm_devel keeps LLVM static archives and
# adds developer tools. --build-arg ROCM_PARENT=rocm_base builds the same
# product stages without those archives or tools.
ARG ROCM_PARENT=rocm_devel
ARG PYTORCH_ROCM_ARCH="${ROCM_GFX_TARGETS}"
ARG TRITON_COMMIT="669b31acc1dd1b3fd93286afd5db67f65d9f7557"
ARG PYTORCH_COMMIT="3369fa23f831832166651a0b8e151dc2877f3c77"
ARG PYTORCH_VISION_COMMIT="53881ee74892a7c22f2b16a84b15a00f64a8bf68"
ARG PYTORCH_AUDIO_COMMIT="b3ec2afa3ae504ca600d5e08956eb13d6e2aee31"
ARG PYTORCH_CODEC_COMMIT="dc0f10da1fa2c807dedb7ed97de7b36d762b968b"
# deps image arguments
ARG AITER_COMMIT="e2d019f15599b73360ae027b73b8d72961903bd2"
ARG LONGCONTEXTATTENTION_COMMIT="631bdfd"
ARG DIFFUSERS_COMMIT="51349f7ac2da4853852efdc1befc92669946e68a"
ARG DISTVAE_COMMIT="dce484185dc11d7406076117771e36acd796aa6a"
ARG XDIT_COMMIT="ce8f789fae6247e5ccf9672a273394a64039442b"
ARG AO_COMMIT="92dcc96162f21928092f8e8e35bac29d3b180e34"
ARG ARBITER_COMMIT="252b0301d072f9d6ea895e32f6898fed951cf295"

FROM ${BASE_IMAGE} AS base_os

FROM base_os AS build_python
ARG PYTHON_VERSION
ARG DEBIAN_FRONTEND=noninteractive
RUN if [ "${PYTHON_VERSION}" = "default" ]; then \
        mkdir -p /opt/python/usr; \
    else \
        # install python3 (optional) dependencies on Ubuntu 24.04
        echo "deb-src http://archive.ubuntu.com/ubuntu noble main universe" \
          >> /etc/apt/sources.list; \
        apt-get update -qq && apt-get build-dep python3 -y && apt-get install --no-install-recommends -y \
            build-essential \
            ca-certificates \
            gdb \
            lcov \
            pkg-config \
            libbz2-dev \
            # unclear if needed
            libexpat1-dev \
            libffi-dev \
            libgdbm-dev \
            libgdbm-compat-dev \
            liblzma-dev \
            libncurses5-dev \
            libreadline6-dev \
            libsqlite3-dev \
            libssl-dev \
            lzma \
            lzma-dev \
            tk-dev \
            uuid-dev \
            zlib1g-dev \
            # do not install on Ubuntu 24.04
#            libmpdec-dev \
            libzstd-dev \
            inetutils-inetd \
            # unclear if needed
            systemtap-sdt-dev \
            wget && \
            update-ca-certificates && \
            rm -rf /var/lib/apt/lists/*; \
        # build prespecified Python version
        wget https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz; \
        tar -xf Python-${PYTHON_VERSION}.tgz; \
        cd Python-${PYTHON_VERSION}; \
        ./configure \
            --prefix=/usr \
            --enable-shared \
            --enable-optimizations \
            --enable-ipv6 \
            --with-system-ffi \
            # unclear if needed
            --with-system-expat \
            --with-dbmliborder=bdb:gdbm \
            --enable-loadable-sqlite-extensions \
            --with-dtrace; \
        make -j$(nproc); \
        make install DESTDIR=/opt/python; \
    fi

FROM base_os AS base
ARG PYTHON_VERSION
ARG DEBIAN_FRONTEND=noninteractive

# Shared fetch/compiler tools. Native extensions in core (AITER, torchao)
# and the torch/ffmpeg builders still need a host toolchain.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    ninja-build \
    wget && \
    update-ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# install python3
COPY --from=build_python /opt/python/usr /usr
RUN if [ "${PYTHON_VERSION}" = "default" ]; then \
        # install system Python
        apt-get update -qq && apt-get install --no-install-recommends -y \
            python3 \
            python3-dev \
            python3-packaging \
            python3-pip \
            python3-venv && \
            rm -rf /var/lib/apt/lists/*; \
    else \
        # install Python optional runtime dependencies
        apt-get update -qq && apt-get install -y --no-install-recommends \
            ca-certificates \
            # from libbz2-dev
            libbz2-1.0 \
            # from libc6-dev
            libc6 \
            # from libffi-dev
            libffi8 \
            # from libgdbm-dev
            libgdbm6t64 \
            # from libgdbm-dev
            libgdbm-compat4t64 \
            # from liblzma-dev
            liblzma5 \
            # from libreadline6-dev
            libreadline8 \
            # from libsqlite3-dev
            libsqlite3-0 \
            # from libssl-dev
            libssl3t64 \
            # from tk-dev
            tk \
            # from uuid-dev
            libuuid1 \
            # from zlib1g-dev
            zlib1g \
            # from libzstd-dev
            libzstd1 \
            # rest are more unclear dependencies
            libdb5.3 \
            libexpat1 \
            libgdbm6 \
            libncurses6 \
            libtirpc3 \
            uuid-runtime && \
            rm -rf /var/lib/apt/lists/*; \
        # setup prespecified Python version
        PYTHON_MINOR="$(echo "$PYTHON_VERSION" | awk -F. '{print $1"."$2}')"; \
        ln -sf /usr/bin/python${PYTHON_MINOR} /usr/bin/python3; \
        ln -sf /usr/bin/pip${PYTHON_MINOR} /usr/bin/pip3; \
        python3 -m ensurepip --upgrade; \
    fi

# setup environment
RUN python3 -m venv venv
ENV PATH="/venv/bin:$PATH"
RUN pip install --no-cache-dir --upgrade pip packaging setuptools wheel

# rocm_tree and rocm_base install the same packages from `base`. The archive
# delete has to be inside the install it applies to: a child cannot drop
# files from a parent layer, and rocm_devel needs the archives this stage keeps.
FROM base AS rocm_tree
ARG ROCM_PACKAGE_REPOSITORY
ARG ROCM_RELEASE_ID
ARG ROCM_DEB_SERIES
ARG ROCM_GFX_TARGETS
COPY docker/configure_rocm_legacy_repo.sh /usr/local/bin/configure_rocm_legacy_repo
COPY docker/configure_rocm_native_repo.sh /usr/local/bin/configure_rocm_native_repo
COPY docker/install_rocm_debs.sh /usr/local/bin/install_rocm_debs
COPY docker/setup_amdsmi.sh /usr/local/bin/setup_amdsmi
COPY docker/setup_rocm_llvm_layout.sh /usr/local/bin/setup_rocm_llvm_layout
COPY docker/setup_origami_cmake.sh /usr/local/bin/setup_origami_cmake
RUN chmod +x /usr/local/bin/configure_rocm_legacy_repo \
        /usr/local/bin/configure_rocm_native_repo \
        /usr/local/bin/install_rocm_debs \
        /usr/local/bin/setup_amdsmi \
        /usr/local/bin/setup_rocm_llvm_layout \
        /usr/local/bin/setup_origami_cmake \
    && install_rocm_debs base keep-archives
# The nightly deb ships the amd-smi Python bindings somewhere pip cannot reach;
# link them into site-packages. Prints a RETIRE banner and does nothing once a
# nightly makes `import amdsmi` work on its own.
RUN setup_amdsmi
ENV PATH="/opt/rocm/lib/llvm/bin:/opt/rocm/bin:$PATH" \
    ROCM_HOME=/opt/rocm \
    ROCM_PATH=/opt/rocm \
    HIP_CLANG_PATH=/opt/rocm/lib/llvm/bin \
    HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode \
    TRITON_HIP_LLD_PATH=/opt/rocm/lib/llvm/bin/ld.lld
# Nightly debs leave $ROCM_PATH/llvm/bin as a stub; FlyDSL/MLIR still
# invoke ld.lld there. Prints a RETIRE banner and does nothing once a
# nightly ships that path itself. Also retire if FlyDSL stops looking
# there. PATH is the ENV above, not this shim.
RUN setup_rocm_llvm_layout
# hipBLASLt's CMake config find_dependency(origami) next to hipblaslt;
# nightly debs ship liborigami.so without lib/cmake/origami. Prints a
# RETIRE banner and does nothing once a nightly ships that package.
RUN setup_origami_cmake

FROM base AS rocm_base
ARG ROCM_PACKAGE_REPOSITORY
ARG ROCM_RELEASE_ID
ARG ROCM_DEB_SERIES
ARG ROCM_GFX_TARGETS
COPY docker/configure_rocm_legacy_repo.sh /usr/local/bin/configure_rocm_legacy_repo
COPY docker/configure_rocm_native_repo.sh /usr/local/bin/configure_rocm_native_repo
COPY docker/install_rocm_debs.sh /usr/local/bin/install_rocm_debs
COPY docker/setup_amdsmi.sh /usr/local/bin/setup_amdsmi
COPY docker/setup_rocm_llvm_layout.sh /usr/local/bin/setup_rocm_llvm_layout
COPY docker/setup_origami_cmake.sh /usr/local/bin/setup_origami_cmake
RUN chmod +x /usr/local/bin/configure_rocm_legacy_repo \
        /usr/local/bin/configure_rocm_native_repo \
        /usr/local/bin/install_rocm_debs \
        /usr/local/bin/setup_amdsmi \
        /usr/local/bin/setup_rocm_llvm_layout \
        /usr/local/bin/setup_origami_cmake \
    && install_rocm_debs base strip-archives
RUN setup_amdsmi
ENV PATH="/opt/rocm/lib/llvm/bin:/opt/rocm/bin:$PATH" \
    ROCM_HOME=/opt/rocm \
    ROCM_PATH=/opt/rocm \
    HIP_CLANG_PATH=/opt/rocm/lib/llvm/bin \
    HIP_DEVICE_LIB_PATH=/opt/rocm/lib/llvm/amdgcn/bitcode \
    TRITON_HIP_LLD_PATH=/opt/rocm/lib/llvm/bin/ld.lld
RUN setup_rocm_llvm_layout
RUN setup_origami_cmake

FROM rocm_tree AS rocm_devel
ARG ROCM_PACKAGE_REPOSITORY
ARG ROCM_RELEASE_ID
ARG ROCM_DEB_SERIES
ARG ROCM_GFX_TARGETS
RUN install_rocm_debs devel
ENV PATH="/opt/rocm/libexec/rocprofiler-compute:$PATH"

# Shared checkout tooling for the torch stack. Each project is fetched and
# built in its own stage so a downstream pin does not recompile Triton or
# PyTorch. Vision, audio, and torchcodec depend on the PyTorch wheel and not
# on each other, so BuildKit runs those three stages in parallel. core still
# installs /install/*.whl from build_torch_stack.
FROM rocm_tree AS torch_build_base
ARG THEROCK_COMMIT
ARG DEBIAN_FRONTEND=noninteractive

# CPU BLAS headers for the PyTorch wheel. Runtime libs are installed in core.
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libopenblas-dev \
    pkg-config && \
    rm -rf /var/lib/apt/lists/*

# TheRock is only needed for external-builds/pytorch checkout scripts.
WORKDIR /app
RUN git init TheRock && \
    cd TheRock && \
    git remote add origin https://github.com/ROCm/TheRock.git && \
    git fetch --depth 1 origin ${THEROCK_COMMIT} && \
    git checkout --detach FETCH_HEAD

# needed for HIPIFY commits created by the build process
RUN git config --global user.name "TheRock Builder" && \
    git config --global user.email "builder@rocm.ai"

WORKDIR /app/TheRock/external-builds/pytorch
RUN pip install -r /app/TheRock/requirements.txt && \
    mkdir -p /install

FROM torch_build_base AS build_triton
ARG TRITON_COMMIT
RUN python pytorch_triton_repo.py checkout --gitrepo-origin https://github.com/ROCm/triton.git --repo-hashtag ${TRITON_COMMIT} --jobs 8 --depth 1
RUN cd triton && \
    pip install -r python/requirements.txt && \
    pip wheel . --wheel-dir dist/ && \
    pip install dist/*.whl && \
    mv dist/*.whl /install && \
    rm -rf build python/build dist

# License bundles sit beside the compiles, one stage per project, so a
# collector change reruns the scan and leaves the wheel builds cached.
# --required-git-depth 0 requires the project repository itself. Nested
# submodules are recorded, and a missing submodule license stays a warning,
# matching the previous scan of the parent directory at depth 1.
FROM build_triton AS evidence_triton
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /evidence/triton \
    --scan-root triton=/app/TheRock/external-builds/pytorch/triton \
    --git-root /app/TheRock/external-builds/pytorch/triton \
    --fail-on-missing-git-license \
    --required-git-depth 0

FROM build_triton AS build_pytorch
ARG PYTORCH_COMMIT
ARG PYTORCH_ROCM_ARCH
RUN python pytorch_torch_repo.py checkout --gitrepo-origin https://github.com/ROCm/pytorch.git --repo-hashtag ${PYTORCH_COMMIT} --jobs 8 --depth 1
RUN cd pytorch && \
    UPSTREAM_HASH=$(git rev-parse --short THEROCK_UPSTREAM_DIFFBASE) && \
    PYTORCH_VERSION=$(cat version.txt | tr -d '\n') && \
    pip install -r requirements.txt && \
    BUILD_TEST=0 \
    USE_KINETO=ON USE_GLOO=ON USE_ROCM=ON USE_CUDA=OFF USE_MPI=OFF \
    USE_MEM_EFF_ATTENTION=ON USE_FLASH_ATTENTION=ON USE_ROCM_CK_SDPA=ON \
    PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" \
    PYTORCH_BUILD_VERSION="${PYTORCH_VERSION}+git${UPSTREAM_HASH}" \
    PYTORCH_BUILD_NUMBER=1 \
    CXXFLAGS="-I${ROCM_HOME}/include/roctracer -I${ROCM_HOME}/lib/rocm_sysdeps/include" \
    LDFLAGS="-L${ROCM_HOME}/lib/rocm_sysdeps/lib" \
    PKG_CONFIG_PATH="${ROCM_HOME}/lib/rocm_sysdeps/lib/pkgconfig" \
    python setup.py bdist_wheel && \
    pip install dist/*.whl && \
    mv dist/*.whl /install && \
    rm -rf build dist

FROM build_pytorch AS evidence_pytorch
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /evidence/pytorch \
    --scan-root pytorch=/app/TheRock/external-builds/pytorch/pytorch \
    --git-root /app/TheRock/external-builds/pytorch/pytorch \
    --fail-on-missing-git-license \
    --required-git-depth 0

FROM build_pytorch AS build_vision
ARG PYTORCH_VISION_COMMIT
RUN python pytorch_vision_repo.py checkout --gitrepo-origin https://github.com/ROCm/vision.git --repo-hashtag ${PYTORCH_VISION_COMMIT} --jobs 8 --depth 1
RUN mkdir -p /wheel && \
    cd pytorch_vision && \
    FORCE_CUDA=1 TORCHVISION_USE_NVJPEG=0 TORCHVISION_USE_VIDEO_CODEC=0 \
    python setup.py bdist_wheel && \
    mv dist/*.whl /wheel && \
    rm -rf build dist

FROM build_vision AS evidence_vision
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /evidence/vision \
    --scan-root vision=/app/TheRock/external-builds/pytorch/pytorch_vision \
    --git-root /app/TheRock/external-builds/pytorch/pytorch_vision \
    --fail-on-missing-git-license \
    --required-git-depth 0

FROM build_pytorch AS build_audio
ARG PYTORCH_AUDIO_COMMIT
ARG PYTORCH_ROCM_ARCH
RUN python pytorch_audio_repo.py checkout --gitrepo-origin https://github.com/ROCm/audio.git --repo-hashtag ${PYTORCH_AUDIO_COMMIT} --jobs 8 --depth 1
RUN mkdir -p /wheel && \
    cd pytorch_audio && \
    PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" USE_ROCM=1 USE_CUDA=0 USE_FFMPEG=1 USE_OPENMP=1 BUILD_SOX=0 \
    python setup.py bdist_wheel && \
    mv dist/*.whl /wheel && \
    rm -rf build dist

FROM build_audio AS evidence_audio
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /evidence/audio \
    --scan-root audio=/app/TheRock/external-builds/pytorch/pytorch_audio \
    --git-root /app/TheRock/external-builds/pytorch/pytorch_audio \
    --fail-on-missing-git-license \
    --required-git-depth 0

FROM base AS ffmpeg_builder
# Reference: https://trac.ffmpeg.org/wiki/CompilationGuide/Ubuntu
# Install build depedencies, server use only
RUN apt-get update -qq && apt-get -y install --no-install-recommends \
    autoconf \
    automake \
    build-essential \
    ca-certificates \
    cmake \
    git-core \
    libaom-dev \
    libass-dev \
    libdav1d-dev \
    libfreetype6-dev \
    libgnutls28-dev \
    libmp3lame-dev \
    libopenh264-dev \
    libtool \
    libunistring-dev \
    libvorbis-dev \
    meson \
    ninja-build \
    pkg-config \
    texinfo \
    wget \
    yasm \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# See https://ffmpeg.org/releases/ for valid choices of FFMPEG_VERSION
ARG FFMPEG_VERSION="7.1.3"
ENV FFMPEG_BUILD_DIR=/ffmpeg/build
ENV FFMPEG_SRC_DIR=/ffmpeg/src
ENV FFMPEG_BIN_DIR=/ffmpeg/bin
RUN mkdir -p ${FFMPEG_BUILD_DIR} ${FFMPEG_SRC_DIR}
WORKDIR ${FFMPEG_SRC_DIR}
# Never set --enable-gpl or --enable-nonfree to maintain non-GPL license compliance!
RUN wget -O ffmpeg-${FFMPEG_VERSION}.tar.bz2 https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.bz2 && \
    tar xjvf ffmpeg-${FFMPEG_VERSION}.tar.bz2 && \
    cd ffmpeg-${FFMPEG_VERSION} && \
    PATH="$FFMPEG_BIN_DIR:$PATH" PKG_CONFIG_PATH="$FFMPEG_BUILD_DIR/lib/pkgconfig" ./configure \
    --prefix="$FFMPEG_BUILD_DIR" \
    --pkg-config-flags="--static" \
    --extra-cflags="-I$FFMPEG_BUILD_DIR/include" \
    --extra-ldflags="-L$FFMPEG_BUILD_DIR/lib" \
    --extra-libs="-lpthread -lm" \
    --ld="g++" \
    --bindir="$FFMPEG_BIN_DIR" \
    --enable-gnutls \
    --enable-libaom \
    --enable-libass \
    --enable-libdav1d \
    --enable-libfreetype \
    --enable-libmp3lame \
    --enable-libopenh264 \
    --enable-libvorbis \
    --enable-shared && \
    PATH="$FFMPEG_BIN_DIR:$PATH" make -j$(($(nproc)-1)) && \
    make install && \
    hash -r
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /ffmpeg/license-evidence \
    --scan-root ffmpeg=${FFMPEG_SRC_DIR}

# fetch torchcodec - TODO: after merging https://github.com/ROCm/TheRock/pull/2590 switch to using the functionality there
FROM build_pytorch AS build_codec
ARG PYTORCH_CODEC_COMMIT
ARG PYTORCH_ROCM_ARCH
ARG DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/meta-pytorch/torchcodec.git pytorch_codec && \
    cd pytorch_codec && \
    git reset --hard ${PYTORCH_CODEC_COMMIT}
# I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION to link against ffmpeg built
# without --enable-gpl or --enable-nonfree.
COPY --from=ffmpeg_builder /ffmpeg/build /ffmpeg/build
RUN mkdir -p /wheel && \
    pip install --no-cache-dir pybind11 pybind11[global] && \
    cd pytorch_codec && \
    PKG_CONFIG_PATH=/ffmpeg/build/lib/pkgconfig \
    I_CONFIRM_THIS_IS_NOT_A_LICENSE_VIOLATION=1 \
    PYTORCH_ROCM_ARCH="${PYTORCH_ROCM_ARCH}" ENABLE_CUDA=0 TORCHCODEC_DISABLE_COMPILE_WARNING_AS_ERROR=1 \
    python -m build --wheel -vvv --no-isolation -o dist && \
    mv dist/*.whl /wheel && \
    rm -rf build dist

FROM build_codec AS evidence_codec
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /evidence/codec \
    --scan-root codec=/app/TheRock/external-builds/pytorch/pytorch_codec \
    --git-root /app/TheRock/external-builds/pytorch/pytorch_codec \
    --fail-on-missing-git-license \
    --required-git-depth 0

# Triton and PyTorch wheels are already in /install. The three wheels below
# come from stages BuildKit schedules together. Each evidence stage scanned
# only its own checkout; this stage imports those bundles.
FROM build_pytorch AS build_torch_stack
COPY --from=build_vision /wheel/ /install/
COPY --from=build_audio /wheel/ /install/
COPY --from=build_codec /wheel/ /install/
COPY --from=evidence_triton /evidence/triton/ /evidence/triton/
COPY --from=evidence_pytorch /evidence/pytorch/ /evidence/pytorch/
COPY --from=evidence_vision /evidence/vision/ /evidence/vision/
COPY --from=evidence_audio /evidence/audio/ /evidence/audio/
COPY --from=evidence_codec /evidence/codec/ /evidence/codec/
RUN pip install --no-cache-dir \
    /install/torchvision-*.whl \
    /install/torchaudio-*.whl \
    /install/torchcodec-*.whl
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /install/license-evidence \
    --evidence-root triton=/evidence/triton \
    --evidence-root pytorch=/evidence/pytorch \
    --evidence-root vision=/evidence/vision \
    --evidence-root audio=/evidence/audio \
    --evidence-root codec=/evidence/codec

FROM ${ROCM_PARENT} AS core
ARG AITER_COMMIT
RUN --mount=type=bind,from=build_torch_stack,source=/install,target=/install \
    pip install --no-cache-dir /install/*.whl
# Runtime libs for torchcodec/FFmpeg, OpenBLAS-linked torch, and OpenCV/GLib.
RUN apt-get update -qq && apt-get -y install --no-install-recommends \
  libaom3 \
  libass9 \
  libdav1d7 \
  libfreetype6 \
  libgfortran5 \
  libgl1 \
  libglib2.0-0t64 \
  libgnutls30 \
  libmp3lame0 \
  libopenblas0 \
  libopenh264-7 \
  libvorbis0a \
  libvorbisenc2 \
  && rm -rf /var/lib/apt/lists/*
# Copy built FFmpeg artifacts from the builder stage
COPY --from=ffmpeg_builder /ffmpeg/bin /usr/local/bin
COPY --from=ffmpeg_builder /ffmpeg/build/lib /usr/local/lib
COPY --from=ffmpeg_builder /ffmpeg/build/include /usr/local/include
COPY --from=ffmpeg_builder /ffmpeg/build/share /usr/local/share
# Update library cache
RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig
COPY docker/libkineto.conf /config/libkineto.conf
ENV KINETO_CONFIG="/config/libkineto.conf"
# install aiter
WORKDIR /app/external
# Keep the Triton wheel we built from TRITON_COMMIT against our PyTorch; otherwise
# AITER's setup.py would uninstall it and pull a wheel from pypi.amd.com (see
# https://github.com/ROCm/aiter/pull/3161). No-op on AITER_COMMIT pins predating
# that PR, but safe and forward-compatible.
ENV AITER_USE_SYSTEM_TRITON=1
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/ROCm/aiter.git && \
    cd aiter && \
    git reset --hard ${AITER_COMMIT} && \
    git apply /patches/aiter_mha_functional_varlen.patch && \
    git submodule update --init --recursive && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install -e .
# Held in core rather than final so that no stage downstream of core has an edge
# back into a builder stage.
COPY --from=build_torch_stack /install/license-evidence /opt/license-evidence/torch-build-sources
COPY --from=ffmpeg_builder /ffmpeg/license-evidence /opt/license-evidence/ffmpeg-build-sources

FROM core AS deps
ARG LONGCONTEXTATTENTION_COMMIT
ARG DIFFUSERS_COMMIT
ARG DISTVAE_COMMIT
ARG XDIT_COMMIT
ARG AO_COMMIT
ARG ARBITER_COMMIT

# setup
WORKDIR /app/external
# install yunchang
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/feifeibear/long-context-attention.git && \
    cd long-context-attention && \
    git reset --hard ${LONGCONTEXTATTENTION_COMMIT} && \
    git apply /patches/yunchang_aiter_round_mode.patch && \
    pip install -e .
# install transformers with [sentencepiece] extras that brings in protobuf, required for T5 tokenizers
RUN pip install --no-cache-dir "transformers[sentencepiece]==5.16.1"
# install diffusers
# ftfy is an optional dependency, we install it as needed for StableDiffusion 3.5 (CLIP-based encoder pipelines)
# final rm step is needed presently to pass a release process image scan
RUN git clone https://github.com/huggingface/diffusers.git && \
    cd diffusers && \
    git reset --hard ${DIFFUSERS_COMMIT} && \
    pip install -e ".[torch]" && \
    rm scripts/convert_vq_diffusion_to_diffusers.py && \
    pip install --no-cache-dir "ftfy"
# install torchao
RUN git clone https://github.com/pytorch/ao.git && \
    cd ao && \
    git reset --hard ${AO_COMMIT} && \
    pip install -e . --no-build-isolation
# install arbiter
RUN git clone https://github.com/fal-ai/arbiter.git && \
    cd arbiter && \
    git reset --hard ${ARBITER_COMMIT} && \
    # too strict torch version, drop dependency
    sed -i '/numpy/d' pyproject.toml && \
    # the requested pyiqa version depends on transformers==4.37.2 which we cannot use
    sed -i '/pyiqa/d' pyproject.toml && \
    # numba dependency is not used
    sed -i '/numba/d' pyproject.toml && \
    # facexlib is not used
    sed -i '/facexlib/d' pyproject.toml && \
    # drop llvmlite
    sed -i '/llvmlite/d' pyproject.toml && \
    # to be sure, pin numpy and transformers to their current versions
    pip freeze | grep -E 'numpy|transformers' > constraints.txt && \
    pip install --no-cache-dir -c constraints.txt -e .
# install distvae
RUN git clone https://github.com/xdit-project/DistVAE.git && \
    cd DistVAE && \
    git reset --hard ${DISTVAE_COMMIT} && \
    pip install -e .
# install xfuser
WORKDIR /app
RUN --mount=type=bind,source=patches,target=/patches \
    git clone https://github.com/xdit-project/xDiT.git && \
    cd xDiT && \
    git reset --hard ${XDIT_COMMIT} && \
    git apply /patches/xfuser_ltx25_disable_gc_during_inference.patch && \
    pip freeze | grep numpy > constraints.txt && \
    pip install -c constraints.txt -e .
# rocprofiler-compute ships with rocm_devel. ROCM_PARENT=rocm_base has no tree.
# Due to https://github.com/ROCm/rocm-systems/pull/2821 drop numpy to avoid installing numpy<2
RUN if [ -f "${ROCM_PATH}/libexec/rocprofiler-compute/requirements.txt" ]; then \
        sed -i '/numpy/d' "${ROCM_PATH}/libexec/rocprofiler-compute/requirements.txt" && \
        pip install --no-cache-dir -r "${ROCM_PATH}/libexec/rocprofiler-compute/requirements.txt"; \
    fi
# imageio + imageio-ffmpeg for diffusers export_to_video H.264 encoding
# --no-binary avoids shipping imageio-ffmpeg's bundled GPL ffmpeg binary
RUN pip install --no-cache-dir --no-binary :all: imageio-ffmpeg
RUN pip install --no-cache-dir imageio

FROM core AS final
# by copying from the deps stage we leave behind all cache and temporary files created during installation
COPY --from=deps /venv /venv
COPY --from=deps /app /app
COPY LICENSE /tmp/project-license/LICENSE

# install basic terminal utilities
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    less \
    nano \
    vim \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
# copy assets
COPY assets/data /app/data
# copy instructions and CI prerequisites
COPY assets/docs/README.md /app/README.md
COPY .ci/run.py /app/.ci/run.py
COPY .ci/memory_sampler.py /app/.ci/memory_sampler.py
COPY .ci/miopen_driver_commands.py /app/.ci/miopen_driver_commands.py
COPY .ci/determinism_report.py /app/.ci/determinism_report.py
COPY benchmark_configs/xdit/ /app/.ci/benchmark_configs/
COPY src/sweep_tooling/generate_sweep_configs.py /app/.ci/tools/generate_sweep_configs.py
COPY .ci/quality_check.py /app/.ci/quality_check.py
# use shared MIOpen databases
COPY ./data/miopen/userdb /miopen_userdb
ENV MIOPEN_USER_DB_PATH="/miopen_userdb"

# Generate third-party license evidence from the final filesystem instead of
# maintaining a dependency list separately from the image build.
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /usr/share/licenses/diffusion-models-inference \
    --scan-root app=/app \
    --scan-root project=/tmp/project-license \
    --scan-root python=/venv \
    --scan-root rocm=/opt/rocm \
    --scan-root local=/usr/local \
    --evidence-root torch-build-sources=/opt/license-evidence/torch-build-sources \
    --evidence-root ffmpeg-build-sources=/opt/license-evidence/ffmpeg-build-sources \
    --git-root /app \
    --python-root /venv \
    --debian \
    --fail-on-missing-git-license \
    --required-git-depth 2 && \
    rm -rf /tmp/project-license \
        /usr/local/libexec/collect_image_licenses.py
