# Build example image with
#
# docker build -f docker/Dockerfile.cuda \
#              -t pytorch_xdit_cuda .
#
# when running from repository root.
#

# deps image arguments
ARG FLASHATTENTION_COMMIT="fffabc3"
ARG LONGCONTEXTATTENTION_COMMIT="631bdfd"
ARG DIFFUSERS_COMMIT="a80b19218b4bd4faf2d6d8c428dcf1ae6f11e43d"
ARG ACCELERATE_COMMIT="46ba4818cca2103195d7b953779c63ee4027ce61"
ARG DISTVAE_COMMIT="bf7531e"
ARG XDIT_COMMIT="45c44e7"
ARG AO_COMMIT="8b72284"
ARG SAGEATTENTION_COMMIT="d1a57a5"

ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.06-py3
FROM ${BASE_IMAGE} AS core

# For ImportError: libGL.so.1: cannot open shared object file on nvcr.io/nvidia/pytorch:25.06-py3
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsm6 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

FROM core AS deps
ARG FLASHATTENTION_COMMIT
ARG LONGCONTEXTATTENTION_COMMIT
ARG DIFFUSERS_COMMIT
ARG ACCELERATE_COMMIT
ARG DISTVAE_COMMIT
ARG XDIT_COMMIT
ARG AO_COMMIT

# setup
WORKDIR /app/external
COPY src/patches /patches
COPY src/patches-private /patches-private
# install flash-attention
RUN pip uninstall -y flash_attn && \
    git clone https://github.com/Dao-AILab/flash-attention.git && \
    cd flash-attention && \
    git reset --hard ${FLASHATTENTION_COMMIT} && \
    python setup.py install && \
    (cd hopper && python setup.py install) && \
    (cd flash_attn/cute && pip install -e .)
# install yunchang
RUN git clone https://github.com/feifeibear/long-context-attention.git && \
    cd long-context-attention && \
    git reset --hard ${LONGCONTEXTATTENTION_COMMIT} && \
    pip install -e .
# install diffusers
RUN git clone https://github.com/huggingface/diffusers.git && \
    cd diffusers && \
    git reset --hard ${DIFFUSERS_COMMIT} && \
    pip install -e ".[torch]"
# install accelerate
RUN git clone https://github.com/huggingface/accelerate.git && \
    cd accelerate && \
    git reset --hard ${ACCELERATE_COMMIT} && \
    pip install -e .
# install torchao
RUN git clone https://github.com/pytorch/ao.git && \
    cd ao && \
    git reset --hard ${AO_COMMIT} && \
    pip install -e . --no-build-isolation
# install distvae
RUN git clone https://github.com/xdit-project/DistVAE.git && \
    cd DistVAE && \
    git reset --hard ${DISTVAE_COMMIT} && \
    pip install -e .
# install sageattention
RUN git clone https://github.com/thu-ml/SageAttention.git && \
    cd SageAttention && \
    git reset --hard ${SAGEATTENTION_COMMIT} && \
    TORCH_CUDA_ARCH_LIST="9.0" python3 setup.py install
# install xfuser
WORKDIR /app
RUN git clone https://github.com/xdit-project/xDiT.git && \
    cd xDiT && \
    git reset --hard ${XDIT_COMMIT} && \
    pip freeze | grep numpy > constraints.txt && \
    pip install -c constraints.txt -e .
# hotfix: until diffusers installs ftfy
RUN pip install ftfy
# hotfix: transformers<5.0.0 required for good output quality
RUN pip uninstall -y transformers && pip install --no-cache-dir "transformers==4.57.6"
# hotfix: transformers needs protobuf
RUN pip install --no-cache-dir "protobuf==6.33.5"
# cleanup
RUN rm -fr /patches
RUN rm -fr /patches-private

FROM deps AS final

WORKDIR /app
# copy assets
COPY src/flux/cat.png /app/data/flux_cat.png
COPY src/wan_xdit/assets/i2v_input.JPG /app/data/wan_input.jpg
# copy instructions and CI prerequisites
COPY docs/pytorch-xdit/README.md /app/README.md
COPY .ci/run.py /app/.ci/run.py
COPY benchmark_configs/ /app/.ci/benchmark_configs/
COPY src/sweep_tooling/generate_sweep_configs.py /app/.ci/tools/generate_sweep_configs.py
# apex causes rms_forward_affine crash in SD3.5
# numpy>2 causes a runtime error in Hunyuanvideo
# opencv-python is required by xDiT export_to_video
RUN pip uninstall -y apex && pip install --no-cache-dir "numpy<2" "opencv-python"
