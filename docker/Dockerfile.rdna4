# ---- Reproducible upstream pins -------------------------------------------
ARG ROCM_INDEX=https://stable.repo.amd.com/rocm/whl-next
ARG ROCM_VERSION=10.0.0
ARG TORCH_SPEC=torch[device-gfx1200,device-gfx1201]==2.13.0+rocm10.0.0
ARG TORCHVISION_SPEC=torchvision[device-gfx1200,device-gfx1201]==0.27.0+rocm10.0.0
ARG TORCHAUDIO_SPEC=torchaudio==2.11.0.2+rocm10.0.0
ARG AITER_REPO=https://github.com/pds-amd/aiter.git
ARG AITER_COMMIT=87973ea85d2d5fad92c4ad3d8415b2a0bba641e1
ARG DIFFUSERS_COMMIT=77d9eb4ed7c3e4a1813ddf3b8ba995d4a988f801
ARG XDIT_COMMIT=b714b357cb8f8d394af95ca6fbc2cc81dc1d186d
ARG FLYDSL_VERSION=0.3.2
ARG TRANSFORMERS_VERSION=5.16.1

# ---- LGPL-only ffmpeg -----------------------------------------------------
FROM ubuntu:24.04 AS ffmpeg_builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
        autoconf automake build-essential ca-certificates cmake git-core \
        libaom-dev libass-dev libdav1d-dev libfreetype6-dev libgnutls28-dev \
        libmp3lame-dev libopenh264-dev libtool libunistring-dev libvorbis-dev \
        meson ninja-build pkg-config python3 texinfo wget yasm zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

ARG FFMPEG_VERSION=7.1.5
RUN mkdir -p /ffmpeg/build /ffmpeg/src /ffmpeg/bin
WORKDIR /ffmpeg/src
# Do not add --enable-gpl or --enable-nonfree: this artifact is intended for
# redistribution in client-facing images.
RUN wget -q "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.bz2" && \
    tar xjf "ffmpeg-${FFMPEG_VERSION}.tar.bz2" && \
    cd "ffmpeg-${FFMPEG_VERSION}" && \
    PATH="/ffmpeg/bin:$PATH" PKG_CONFIG_PATH=/ffmpeg/build/lib/pkgconfig ./configure \
        --prefix=/ffmpeg/build \
        --pkg-config-flags=--static \
        --extra-cflags=-I/ffmpeg/build/include \
        --extra-ldflags=-L/ffmpeg/build/lib \
        --extra-libs="-lpthread -lm" \
        --ld=g++ \
        --bindir=/ffmpeg/bin \
        --enable-gnutls \
        --enable-libaom \
        --enable-libass \
        --enable-libdav1d \
        --enable-libfreetype \
        --enable-libmp3lame \
        --enable-libopenh264 \
        --enable-libvorbis \
        --enable-shared && \
    make -j"$(nproc)" && \
    make install

COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /ffmpeg/license-evidence \
    --scan-root ffmpeg=/ffmpeg/src

# ---- AMD-supported, gfx1201-only ROCm + PyTorch ---------------------------
FROM ubuntu:24.04 AS core

USER root
ENV DEBIAN_FRONTEND=noninteractive

# aiter needs a native compiler; ffmpeg needs only the runtime libraries here.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git python3 python3-dev \
        python3-pip python3-venv libdrm2 libdrm-amdgpu1 libelf1 libgomp1 \
        libaom3 libass9 libdav1d7 libfreetype6 libgnutls30 libmp3lame0 \
        libjpeg-dev libnuma-dev libopenh264-7 libvorbis0a libvorbisenc2 \
        less nano vim \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ffmpeg_builder /ffmpeg/bin /usr/local/bin
COPY --from=ffmpeg_builder /ffmpeg/build/lib /usr/local/lib
COPY --from=ffmpeg_builder /ffmpeg/build/include /usr/local/include
COPY --from=ffmpeg_builder /ffmpeg/build/share /usr/local/share
RUN echo /usr/local/lib > /etc/ld.so.conf.d/ffmpeg.conf && \
    ldconfig && \
    /usr/local/bin/ffmpeg -version | head -1

# AMD publishes the framework separately from architecture-specific device code.
# Installing both RDNA4 extras avoids every unrelated GPU's code objects from the
# device-all image. PyPI remains available only for ordinary Python deps;
# exact local-version pins prevent substitution of CPU/CUDA torch wheels.
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv "${VIRTUAL_ENV}"
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

ARG ROCM_INDEX
ARG ROCM_VERSION
ARG TORCH_SPEC
ARG TORCHVISION_SPEC
ARG TORCHAUDIO_SPEC
RUN python3 -m pip install --no-cache-dir --upgrade pip "setuptools<82" wheel && \
    python3 -m pip install --no-cache-dir --pre \
        --index-url "${ROCM_INDEX}" --extra-index-url https://pypi.org/simple \
        "${TORCH_SPEC}" "${TORCHVISION_SPEC}" "${TORCHAUDIO_SPEC}" "numpy==2.5.1" && \
    python3 -m pip install --no-cache-dir --index-url "${ROCM_INDEX}" --no-deps \
        "rocm-sdk-devel==${ROCM_VERSION}" && \
    rocm-sdk init
ENV ROCM_PATH="/opt/venv/lib/python3.12/site-packages/_rocm_sdk_devel"
ENV ROCM_HOME="${ROCM_PATH}"
ENV TRITON_HIP_LLD_PATH="${ROCM_PATH}/llvm/bin/ld.lld"

# Fail early if AMD changes the base image contract or publishes a mismatched
# tag. The exact local torch version suffix is intentionally not assumed.
RUN test "$(rocm-sdk path --root)" = "${ROCM_PATH}" && \
    command -v hipcc && \
    python3 -c "import torch, torchvision, torchaudio; print('torch:', torch.__version__, 'HIP:', torch.version.hip); assert torch.__version__.split('+')[0] == '2.13.0'; assert torch.version.hip" && \
    hipcc --version

# Preserve the AMD-provided torch and Triton builds during all later resolver
# passes. transformers is pinned because major-version movement can break both
# diffusers and xfuser independently of the ROCm stack.
ARG TRANSFORMERS_VERSION
RUN python3 -m pip freeze | grep -iE '^(torch|torchvision|torchaudio|pytorch-triton-rocm|triton|numpy|rocm)==' > /opt/build-constraints.txt && \
    echo "transformers==${TRANSFORMERS_VERSION}" >> /opt/build-constraints.txt && \
    cat /opt/build-constraints.txt
ENV PIP_CONSTRAINT=/opt/build-constraints.txt

ENV AITER_USE_SYSTEM_TRITON=1
ENV PYTORCH_MIOPEN_SUGGEST_NHWC=1
ENV TORCHINDUCTOR_LAYOUT_OPTIMIZATION=1
ENV HIP_FORCE_DEV_KERNARG=1
ENV SAFETENSORS_FAST_GPU=1
ENV PYTORCH_ALLOC_CONF=expandable_segments:True
ENV PYTORCH_HIP_ALLOC_CONF=expandable_segments:True

WORKDIR /app/external

ARG AITER_REPO
ARG AITER_COMMIT
ARG FLYDSL_VERSION
RUN python3 -m pip install --no-cache-dir "flydsl==${FLYDSL_VERSION}" && \
    git clone --recursive "${AITER_REPO}" aiter && \
    cd aiter && \
    git checkout "${AITER_COMMIT}" && \
    git submodule update --init --recursive && \
    echo "aiter at $(git rev-parse HEAD)" && \
    python3 -m pip install --no-cache-dir -r requirements.txt && \
    python3 -m pip install --no-cache-dir --no-build-isolation -e . && \
    python3 -c "import importlib.metadata as m, importlib.util as u, flydsl, torch; assert u.find_spec('aiter'), 'aiter package missing'; print('aiter installed:', m.version('amd-aiter'), 'flydsl:', m.version('flydsl'), 'torch:', torch.__version__)"

ARG DIFFUSERS_COMMIT
RUN git clone https://github.com/huggingface/diffusers.git && \
    cd diffusers && \
    git checkout "${DIFFUSERS_COMMIT}" && \
    echo "diffusers at $(git rev-parse HEAD)" && \
    python3 -m pip install --no-cache-dir -e ".[torch]" ftfy

RUN python3 -m pip install --no-cache-dir \
        "transformers[sentencepiece]==${TRANSFORMERS_VERSION}" \
        imageio yuvio && \
    python3 -m pip install --no-cache-dir --no-binary imageio-ffmpeg imageio-ffmpeg

WORKDIR /app
ARG XDIT_COMMIT
RUN git clone https://github.com/xdit-project/xDiT.git && \
    cd xDiT && \
    git checkout "${XDIT_COMMIT}" && \
    echo "xDiT at $(git rev-parse HEAD)" && \
    python3 -m pip install --no-cache-dir -e ".[optimum-quanto,torchao,opencv-python,cache-dit]" && \
    python3 -c "import importlib.metadata as m, torch; print('final torch:', torch.__version__); print('DistVAE:', m.version('distvae')); print('yunchang:', m.version('yunchang')); assert torch.version.hip" && \
    python3 -c "import diffusers, flydsl, transformers; print('CPU-safe imports OK')" && \
    python3 -c "import importlib.util as u; assert u.find_spec('xfuser'), 'xfuser missing'; assert u.find_spec('cv2'), 'opencv missing'; import cache_dit; print('xDiT and optional extras installed')" && \
    python3 -m pip check

WORKDIR /app

# Runtime assets and CI entry points.
COPY assets/data /app/data
COPY assets/docs/README.md /app/README.md
COPY .ci/run.py /app/.ci/run.py
COPY benchmark_configs/xdit/ /app/.ci/benchmark_configs/
COPY src/sweep_tooling/generate_sweep_configs.py /app/.ci/tools/generate_sweep_configs.py
COPY .ci/quality_check.py /app/.ci/quality_check.py

# Generate third-party license evidence from the final filesystem, retaining
# source evidence for the LGPL-only ffmpeg build stage.
COPY --from=ffmpeg_builder /ffmpeg/license-evidence /tmp/image-license-inputs/ffmpeg-build-sources
COPY LICENSE /tmp/project-license/LICENSE
COPY .ci/collect_image_licenses.py /usr/local/libexec/collect_image_licenses.py
RUN python3 /usr/local/libexec/collect_image_licenses.py \
    --output /usr/share/licenses/diffusion-models-inference \
    --scan-root app=/app \
    --scan-root project=/tmp/project-license \
    --scan-root python=/opt/venv \
    --scan-root rocm="${ROCM_PATH}" \
    --scan-root local=/usr/local \
    --evidence-root ffmpeg-build-sources=/tmp/image-license-inputs/ffmpeg-build-sources \
    --git-root /app \
    --python-root /opt/venv \
    --debian \
    --fail-on-missing-git-license \
    --required-git-depth 2 && \
    rm -rf /tmp/image-license-inputs /tmp/project-license \
        /usr/local/libexec/collect_image_licenses.py
