ARG BASE_IMAGE="amdsiloai/pytorch-xdit:v26.10"
FROM ${BASE_IMAGE}

ARG VLLM_COMMIT="v0.28.0" # v0.28.0
#ARG SGL_COMMIT="2948168" # v0.5.17
#ARG SGL_REPO="https://github.com/sgl-project/sglang.git"

# Necessary PRs manually merged
ARG SGL_COMMIT="perf_branch_1410"
ARG SGL_REPO="https://github.com/avjves/sglang.git"
ENV SGLANG_BUILD_RUST_EXTS=none

WORKDIR /app/external
# Install vLLM
RUN git clone https://github.com/vllm-project/vllm.git && \
    cd vllm && \
    git reset --hard ${VLLM_COMMIT} && \
    pip3 install --no-cache-dir setuptools_scm && \
    pip3 install --no-cache-dir -r requirements/rocm.txt && \
    PYTORCH_ROCM_ARCH="gfx942;gfx950" python3 setup.py develop

# Install SGL
# Build each architecture separately; the patched loader selects its matching library.
# The gfx950 install only registers the sgl_kernel package (reusing the last build/
# output); the per-arch libraries are then copied into gfx942/ and gfx950/ subdirs.
COPY patches/sglang-rocm-arch-loader.patch /tmp/sglang-rocm-arch-loader.patch
RUN git clone ${SGL_REPO} sglang && \
    cd sglang && \
    git checkout ${SGL_COMMIT} && \
    git apply /tmp/sglang-rocm-arch-loader.patch && \
    rm /tmp/sglang-rocm-arch-loader.patch && \
    cd python/sglang/kernels/aot && \
    mv pyproject_rocm.toml pyproject.toml && \
    for arch in gfx942 gfx950; do \
        rm -rf build && \
        AMDGPU_TARGET=${arch} python setup_rocm.py build && \
        mkdir -p /tmp/sgl_ops/${arch} && \
        cp build/lib*/sgl_kernel/common_ops*.so /tmp/sgl_ops/${arch}/ || exit 1; \
    done && \
    AMDGPU_TARGET=gfx950 python setup_rocm.py install && \
    sgl_kernel_dir=$(python -c 'import importlib.util, pathlib; print(pathlib.Path(importlib.util.find_spec("sgl_kernel").origin).parent)') && \
    cp -r /tmp/sgl_ops/gfx942 /tmp/sgl_ops/gfx950 "${sgl_kernel_dir}/" && \
    rm -rf /tmp/sgl_ops && \
    ls "${sgl_kernel_dir}"/gfx942/common_ops*.so "${sgl_kernel_dir}"/gfx950/common_ops*.so && \
    cd ../../../../ && \
    mv python/pyproject_other.toml python/pyproject.toml && \
    sed -i 's/compressed-tensors==0\.15\.0/compressed-tensors==0.17.0/' python/pyproject.toml && \
    sed -i '/numpy/d' python/pyproject.toml && \
    sed -i '/torch/d' python/pyproject.toml && \
    sed -i '/torchvision/d' python/pyproject.toml && \
    sed -i '/transformers/d' python/pyproject.toml && \
    sed -i '/timm/d' python/pyproject.toml && \
    sed -i '/diffusers/d' python/pyproject.toml && \
    sed -i '/accelerate/d' python/pyproject.toml && \
    pip install --no-cache-dir -e "python[all_hip,diffusion]"

# Other dependencies
RUN pip3 install remote_pdb imageio && \
    pip3 uninstall torch_c_dlpack_ext -y

RUN pip3 install "transformers==5.12.1" --upgrade

# Runtime envs
ENV SGLANG_TORCH_COMPILE_MODE="default"
ENV SGLANG_USE_ROCM_VAE=0
ENV SGLANG_USE_AITER=1
ENV SGLANG_USE_ROCM_FLYDSL=1
ENV SGLANG_DIFFUSION_DISABLE_SP_PAD_MASK=1

WORKDIR /app
# Include CI
RUN rm -fr /app/.ci/*
COPY .ci/run.py /app/.ci/run.py
COPY .ci/memory_sampler.py /app/.ci/memory_sampler.py
COPY .ci/miopen_driver_commands.py /app/.ci/miopen_driver_commands.py
COPY src/miopen_tuning /app/.ci/miopen_tuning
COPY .ci/determinism_report.py /app/.ci/determinism_report.py
COPY .ci/integrations/sgld/runner.py /app/.ci/runner.py
COPY benchmark_configs/sgld/ /app/.ci/benchmark_configs/


RUN wget -O /app/data/flux_cat.png https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/cat.png
