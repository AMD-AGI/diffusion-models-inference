ARG BASE_IMAGE="lmsysorg/sglang:v0.5.21"
FROM ${BASE_IMAGE}

ARG SGL_REPO="https://github.com/avjves/sglang.git"
ARG SGL_COMMIT="perf_branch_1410"

ENV SGLANG_BUILD_RUST_EXTS=none

# Optionally reinstall SGL from a custom repo/commit
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ -n "${SGL_REPO}" ]; then \
        pip uninstall -y sglang && \
        git clone ${SGL_REPO} /app/sglang && \
        cd /app/sglang && \
        if [ -n "${SGL_COMMIT}" ]; then git checkout ${SGL_COMMIT}; fi && \
        sed -i -e '/^  "torch/d' \
               -e '/^  "flashinfer/d' \
               -e '/^  "sglang-kernel/d' \
               -e '/^  "sgl-deep-ep/d' \
               -e '/^  "sgl-deep-gemm/d' python/pyproject.toml && \
        pip install "setuptools>=61.0" "setuptools-scm>=8.0" wheel && \
        pip freeze | grep -iE '^(torch|torchvision|torchaudio|torchcodec|torch[-_]memory[-_]saver|flashinfer[-_]python|sglang-kernel|sgl-deep-ep|sgl-deep-gemm)==' \
            > /tmp/keep-base-stack.txt && \
        pip install --no-build-isolation -c /tmp/keep-base-stack.txt -e "python[diffusion]"; \
    fi

# Envs
ENV SGLANG_TORCH_COMPILE_MODE="default"
ENV SGLANG_DIFFUSION_DISABLE_SP_PAD_MASK=1

WORKDIR /app
# copy assets
COPY assets/data /app/data
# Include CI
COPY .ci/run.py /app/.ci/run.py
COPY .ci/memory_sampler.py /app/.ci/memory_sampler.py
COPY .ci/miopen_driver_commands.py /app/.ci/miopen_driver_commands.py
COPY .ci/determinism_report.py /app/.ci/determinism_report.py
COPY .ci/integrations/sgld/runner.py /app/.ci/runner.py
COPY benchmark_configs/sgld/ /app/.ci/benchmark_configs/

RUN wget -O /app/data/flux_cat.png https://huggingface.co/datasets/huggingface/documentation-images/resolve/main/diffusers/cat.png
