--- a/vllm_omni/quantization/factory.py
+++ b/vllm_omni/quantization/factory.py
@@ -95,6 +95,33 @@ def _build_bitsandbytes(**kw: Any) -> QuantizationConfig:
     return DiffusionBitsAndBytesConfig(**kw)
 
 
+def _build_torchao_fp8(
+    granularity: str = "per_tensor",
+    ignored_layers: list[str] | None = None,
+    set_inductor_config: bool = False,
+) -> QuantizationConfig:
+    """Build online TorchAO FP8 W8A8 for native diffusion model layers."""
+    from torchao.quantization.granularity import PerTensor
+    from torchao.quantization.quant_api import (
+        Float8DynamicActivationFloat8WeightConfig,
+    )
+    from vllm.model_executor.layers.quantization.torchao import TorchAOConfig
+
+    if granularity != "per_tensor":
+        raise ValueError(
+            "TorchAO FP8 diffusion quantization currently supports only "
+            f"granularity='per_tensor', got {granularity!r}."
+        )
+
+    return TorchAOConfig(
+        torchao_config=Float8DynamicActivationFloat8WeightConfig(
+            granularity=PerTensor(),
+            set_inductor_config=set_inductor_config,
+        ),
+        skip_modules=ignored_layers or [],
+    )
+
+
 def _build_mxfp8(**kw: Any) -> QuantizationConfig:
     """Lazy import for W8A8 MXFP8 diffusion config (NPU only)."""
     from .mxfp8_config import DiffusionMXFP8Config
@@ -142,6 +169,7 @@ def _build_inc(**kw: Any) -> QuantizationConfig:
 _OVERRIDES: dict[str, Callable[..., QuantizationConfig]] = {
