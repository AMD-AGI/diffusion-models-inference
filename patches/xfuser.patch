+def module_has_nvfp4_weights(module: torch.nn.Module) -> bool:
+    return any(
+        type(param).__name__ == "NVFP4Tensor" and type(param).__module__.startswith("torchao.")
+        for param in module.parameters()
+    )
+
+
+def move_module_to_device(module: torch.nn.Module, device) -> torch.nn.Module:
+    """``module.to(device)``, except for modules holding torchao NVFP4 weights.
+
+    ``Module.to`` cannot be used once NVFP4 weights are present: ``Module._apply`` asks every
+    parameter for ``aten._has_compatible_shallow_copy_type``, which ``NVFP4Tensor`` does not
+    implement. Such modules have each off-device parameter and buffer moved on its own instead;
+    tensors already on ``device`` are left untouched, and tied parameters stay tied.
+    """
+    if device is None:
+        return module
+    if not module_has_nvfp4_weights(module):
+        return module.to(device)
+    target = torch.device(device)
+
+    def on_target(tensor):
+        return tensor.device.type == target.type and (
+            target.index is None or tensor.device.index == target.index
+        )
+
+    moved = {}
+    for submodule in module.modules():
+        for name, param in list(submodule._parameters.items()):
+            if param is None or on_target(param):
+                continue
+            if id(param) not in moved:
+                moved[id(param)] = torch.nn.Parameter(
+                    param.detach().to(target), requires_grad=param.requires_grad
+                )
+            submodule._parameters[name] = moved[id(param)]
+        for name, buffer in list(submodule._buffers.items()):
+            if buffer is None or on_target(buffer):
+                continue
+            if id(buffer) not in moved:
+                moved[id(buffer)] = buffer.to(target)
+            submodule._buffers[name] = moved[id(buffer)]
+    return module
+
+
