+@dataclass(frozen=True)
+class _SameQKVOrTrailingQueryPad(CallConstraint):
+    """Equal Q, K, and V shapes, or K/V already cut to a declared trailing pad.
+
+    USP slices the sequence-parallel pad off K/V by ``valid_kv_len`` but keeps
+    every query row. A kernel that needs equal lengths can still serve that
+    call by attending with the first ``valid_kv_len`` query rows only: the pad
+    rows' output is discarded when the sequence is gathered.
+    """
+
+    def unmet(self, query, key, value, call) -> Optional[str]:
+        if query.shape == key.shape == value.shape:
+            return None
+        valid_kv_len = call.attention_kwargs.get("valid_kv_len")
+        if (
+            key.shape == value.shape
+            and valid_kv_len == key.shape[2] < query.shape[2]
+            and query.shape[:2] == key.shape[:2]
+            and query.shape[3] == key.shape[3]
+        ):
+            return None
+        return SAME_QKV.unmet(query, key, value, call)
