+def _disable_gc_during_call(method):
+    """Disable cyclic GC for one pipeline inference entry point.
+
+    Restores the previous enabled state so callers that already disabled GC,
+    and cleanup that relies on ``gc.collect()``, keep their own policy.
+    """
+    @functools.wraps(method)
+    def wrapper(self, *args, **kwargs):
+        gc_was_enabled = gc.isenabled()
+        gc.disable()
+        try:
+            return method(self, *args, **kwargs)
+        finally:
+            if gc_was_enabled:
+                gc.enable()
+    return wrapper
+
