+def _holds_quantized_parameters(module: torch.nn.Module) -> bool:
+    """Whether any parameter is already in a quantized storage form FSDP1 cannot flatten.
+
+    FSDP1 puts a unit's parameters in one flat allocation of one dtype, and neither shape of
+    quantized weight fits that. A TorchAO layout is a tensor subclass with no flattenable storage,
+    so the wrap dies inside handle.shard() with "Attempted to call resize_() on an invalid python
+    storage"; AITER's float8 weight is an ordinary tensor, but a narrow dtype that cannot share a
+    flat parameter with the bf16 weights beside it. FSDP2 shards each parameter as its own
+    DTensor, and is the path xDiT's Float8Tensor patches exist for.
+
+    Asked of the component rather than taken from the caller because it is a fact about the
+    weights: a quantize_fn says this sharding is about to produce quantized tensors, while a
+    component quantized on the way in from disk already holds them and needs no conversion.
+    """
+    from torch.utils._python_dispatch import is_traceable_wrapper_subclass  # noqa: PLC0415
+
+    return any(
+        is_traceable_wrapper_subclass(parameter)
+        or is_traceable_wrapper_subclass(parameter.data)
+        or parameter.dtype not in _UNQUANTIZED_DTYPES
+        for parameter in module.parameters(recurse=True)
+    )
+
