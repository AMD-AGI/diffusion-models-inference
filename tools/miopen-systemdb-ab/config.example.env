# Copy to config.env in this directory. run_experiment.sh applies each value
# only when that variable is not already set in the environment.
# config.env matches *.env and is gitignored. This example is the tracked template.

# Image built from tools/miopen-systemdb-ab/Dockerfile.
DOCKER_IMAGE=miopen-systemdb-ab:10.1.0-pre3

# All eight GPUs. The script default without this file is GPU 0 only.
HIP_VISIBLE_DEVICES=0,1,2,3,4,5,6,7

# Workload command files, relative to the repository root.
WORKLOADS_GLOB=data/miopen/workloads/*.txt

# Report a shape as equal when the median gap is within this percent.
THRESHOLD_PCT=2.0

# Timed repetitions per command. The report uses the median.
BENCHMARK_REPEATS=3

# Host threads passed into the container.
OMP_NUM_THREADS=16

# Leave unset to write tools/miopen-systemdb-ab/runs/<timestamp>/.
# Must stay inside the repository.
# OUTPUT_DIR=tools/miopen-systemdb-ab/runs/my_run

SKIP_BENCHMARK_A=false
SKIP_TUNE=false
SKIP_BENCHMARK_B=false
DRY_RUN=false
